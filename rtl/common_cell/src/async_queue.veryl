// Ordered ready/valid transport using the standard Gray-pointer asynchronous FIFO.
// Cold reset must cover both ends. Protocol cancellation drains the queue; it must
// not pulse either reset independently. DEPTH is a power of two, at least four.
pub module AsyncQueue #(
    param TYPE: type = logic<8>,
    param DEPTH: u32 = 16,
) (
    s_clk: input 's clock,
    s_rst_n: input 's reset_async_low,
    s_valid: input 's logic,
    s_ready: output 's logic,
    s_data: input 's TYPE,
    d_clk: input 'd clock,
    d_rst_n: input 'd reset_async_low,
    d_valid: output 'd logic,
    d_ready: input 'd logic,
    d_data: output 'd TYPE,
) {
    var full: 's logic;
    var empty: 'd logic;
    assign s_ready = !full;
    assign d_valid = !empty;
    inst queue: $std::async_fifo::<$std::synchronizer_basic> #(
        TYPE, DEPTH, STAGES: 2, USE_OUT_DATA_RESET: false,
    ) (
        is_clk: s_clk, is_rst: s_rst_n,
        os_almost_full: _, os_full: full,
        is_push: s_valid && s_ready, is_data: s_data,
        id_clk: d_clk, id_rst: d_rst_n,
        od_empty: empty, id_pop: d_valid && d_ready, od_data: d_data,
    );
}
