// Fixed synchronous read per port clock; no reset or idle-output validity.
// Positive dimensions/in-range addresses; masked writes preserve unselected bits.
// Match interface dimensions to the cell. Zero-mask write does not turn into a read.
pub proto module Ram1RWContract #(
    param DEPTH     : u32 = 8                                ,
    param WIDTH     : u32 = 32                               ,
    const ADDR_WIDTH: u32 = if DEPTH >: 1 ? $clog2(DEPTH) : 1,
) (
    clk : input   clock                   ,
    port: modport RamReadWritePort::memory,
);
