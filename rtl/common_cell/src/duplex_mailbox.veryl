// Two bounded mailboxes. Cold reset must cover both domains; release is locally synchronous.
// Either sender may buffer one message before its peer starts. Protocol drain belongs to the owner.
pub module DuplexMailbox #(
    param REQUEST_TYPE : type = logic<1>,
    param RESPONSE_TYPE: type = logic<1>,
) (
    s_clk           : input  's clock          ,
    s_rst_n         : input  's reset_async_low,
    s_valid         : input  's logic          ,
    s_ready         : output 's logic          ,
    s_request       : input  's REQUEST_TYPE   ,
    s_response_valid: output 's logic          ,
    s_response_ready: input  's logic          ,
    s_response      : output 's RESPONSE_TYPE  ,
    d_clk           : input  'd clock          ,
    d_rst_n         : input  'd reset_async_low,
    d_valid         : output 'd logic          ,
    d_ready         : input  'd logic          ,
    d_request       : output 'd REQUEST_TYPE   ,
    d_response_valid: input  'd logic          ,
    d_response_ready: output 'd logic          ,
    d_response      : input  'd RESPONSE_TYPE  ,
) {
    inst requests: $std::async_handshake::<$std::synchronizer_basic> #(
        TYPE  : REQUEST_TYPE,
        STAGES: 2           ,
    ) (
        is_clk  : s_clk    ,
        is_rst  : s_rst_n  ,
        is_valid: s_valid  ,
        os_ready: s_ready  ,
        is_data : s_request,
        id_clk  : d_clk    ,
        id_rst  : d_rst_n  ,
        od_valid: d_valid  ,
        id_ready: d_ready  ,
        od_data : d_request,
    );
    inst responses: $std::async_handshake::<$std::synchronizer_basic> #(
        TYPE  : RESPONSE_TYPE,
        STAGES: 2            ,
    ) (
        is_clk  : d_clk           ,
        is_rst  : d_rst_n         ,
        is_valid: d_response_valid,
        os_ready: d_response_ready,
        is_data : d_response      ,
        id_clk  : s_clk           ,
        id_rst  : s_rst_n         ,
        od_valid: s_response_valid,
        id_ready: s_response_ready,
        od_data : s_response      ,
    );
}
