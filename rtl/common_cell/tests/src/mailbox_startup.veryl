// Both ends share cold-reset assertion; release order does not prevent local custody.
#[test(duplex_mailbox_independent_release)]
module MailboxStartupTest {
    inst s_clk:    $tb::clock_gen #( period: 10 );
    inst d_clk:    $tb::clock_gen #( period: 14 );
    var s_rst_n         : 's reset_async_low    ;
    var d_rst_n         : 'd reset_async_low    ;
    var s_valid         : 's logic              ;
    var s_ready         : 's logic              ;
    var s_request       : 's logic          <32>;
    var s_response_valid: 's logic              ;
    var s_response_ready: 's logic              ;
    var s_response      : 's logic          <32>;
    var d_valid         : 'd logic              ;
    var d_ready         : 'd logic              ;
    var d_request       : 'd logic          <32>;
    var d_response_valid: 'd logic              ;
    var d_response_ready: 'd logic              ;
    var d_response      : 'd logic          <32>;
    inst dut: common_cell::DuplexMailbox #(
        REQUEST_TYPE : logic<32>,
        RESPONSE_TYPE: logic<32>,
    ) (
        s_clk             ,
        s_rst_n           ,
        s_valid           ,
        s_ready           ,
        s_request         ,
        s_response_valid  ,
        s_response_ready  ,
        s_response        ,
        d_clk             ,
        d_rst_n           ,
        d_valid           ,
        d_ready           ,
        d_request         ,
        d_response_valid  ,
        d_response_ready  ,
        d_response        ,
    );
    initial {
        s_rst_n          = 0;
        d_rst_n          = 0;
        s_valid          = 0;
        s_request        = 0;
        s_response_ready = 0;
        d_ready          = 0;
        d_response_valid = 0;
        d_response       = 0;
        for first in 0..2 {
            s_rst_n = 0;
            d_rst_n = 0;
            s_clk.next(4);
            d_clk.next(4);
            if first == 0 {
                s_rst_n = 1;
                s_clk.next(2);
                $assert(s_ready, "SOURCE_CAN_BUFFER_BEFORE_PEER_RELEASE");
                s_request = 32'h12345678;
                s_valid   = 1;
                s_clk.next();
                s_valid   = 0;
                s_request = 0;
                s_clk.next(8);
                $assert(!s_ready, "REQUEST_RETAINS_SOURCE_CUSTODY");
                $assert(!d_valid, "REQUEST_HELD_UNTIL_PEER_STARTS");
                d_clk.next();
                d_rst_n = 1;
                d_clk.next(8);
                $assert(d_valid && d_request == 32'h12345678, "EARLY_REQUEST_RETAINED");
                d_ready = 1;
                d_clk.next();
                d_ready = 0;
            } else {
                d_rst_n = 1;
                d_clk.next(2);
                $assert(d_response_ready, "DESTINATION_CAN_BUFFER_BEFORE_PEER_RELEASE");
                d_response       = 32'hfedcba98;
                d_response_valid = 1;
                d_clk.next();
                d_response_valid = 0;
                d_response       = 0;
                d_clk.next(8);
                $assert(!d_response_ready, "RESPONSE_RETAINS_SOURCE_CUSTODY");
                $assert(!s_response_valid, "RESPONSE_HELD_UNTIL_PEER_STARTS");
                s_clk.next();
                s_rst_n = 1;
                s_clk.next(8);
                $assert(s_response_valid && s_response == 32'hfedcba98, "EARLY_RESPONSE_RETAINED");
                s_response_ready = 1;
                s_clk.next();
                s_response_ready = 0;
            }
            s_clk.next(8);
            d_clk.next(8);
            $assert(!d_valid, "NO_REQUEST_REPLAY_AFTER_STARTUP");
            $assert(!s_response_valid, "NO_RESPONSE_REPLAY_AFTER_STARTUP");
        }
        $finish();
    }
}
