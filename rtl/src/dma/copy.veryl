// Static composition: control resources, one execution engine and bus transport.
// Geometry is derived from independent profile inputs; no runtime engine mux.
pub module DmaCopy::<
    R          : $std::axi4_lite_prototype = $std::axi4_lite_pkg::<32, 4, 1>,
    B          : $std::axi4_prototype      = $std::axi4_pkg::<64, 8, 1, 35, 1, 2, 35, 2>,
    BURST_BEATS: u32                       = 8                       ,
    SLOTS      : u32                       = 8                       ,
> #(
    param CHANNEL_COUNT    : u32 = 1,
    param PREFETCH_DEPTH   : u32 = 2,
    param READ_OUTSTANDING : u32 = 8,
    param WRITE_OUTSTANDING: u32 = 8,
    param REQUEST_DEPTH    : u32 = 8,
    param RECEIPT_DEPTH    : u32 = 8,
) (
    reg_clk        : input   'registers clock                                        ,
    reg_rst_n      : input   'registers reset_async_low                              ,
    core_clk       : input   'core      clock                                        ,
    core_rst_n     : input   'core      reset_async_low                              ,
    timer_available: input 'core logic = 0,
    timer_value: input 'core logic<64> = 0,
    maint_valid: input 'core logic = 0,
    maint_abort: input 'core logic = 0,
    maint_context: input 'core u32 = 0,
    maint_channels: input 'core logic<CHANNEL_COUNT> = 0,
    maint_ready: output 'core logic,
    maint_status: output 'core MaintenanceState::Status,
    maint_failed: output 'core logic<CHANNEL_COUNT>,
    bus_clk        : input   'bus       clock                                        ,
    bus_rst_n      : input   'bus       reset_async_low                              ,
    cfg            : modport 'registers $std::axi4_lite_if::<R>::slave               ,
    memory         : modport 'bus       $std::axi4_if::<B>::master                   ,
    awatop         : output  'bus       logic                         <6>            ,
    irq            : output  'core      logic                         <CHANNEL_COUNT>,
    fatal_irq      : output  'core      logic                                        ,
    fatal          : output  'core      logic                                        ,
) {
    initial {
        if B::ID_LENGTH <: $clog2(2 * CHANNEL_COUNT) || PREFETCH_DEPTH == 0 {
            $fatal(1, "Invalid command depth or AXI ID width");
        }
    }
    inst channels     : 'core      DmaChannels #( CHANNEL_COUNT );
    inst requests     : 'core      CopyMemoryPort::<B::DATA_WIDTH_BYTES, BURST_BEATS, SLOTS>;
    inst register_port: 'registers common_cell::RegisterPort;
    inst transactions : 'bus       CopyMemoryPort::<B::DATA_WIDTH_BYTES, BURST_BEATS, SLOTS>;
    var fetch_valid: 'bus       logic                                                              ;
    var fetch_ready: 'bus       logic                                                              ;
    var fetch      : 'bus       CopyMemory::<B::DATA_WIDTH_BYTES, BURST_BEATS, SLOTS>::FetchAddress;
    assign awatop = 0;
    assign maint_ready = channels.maint_status != MaintenanceState::Status::Busy;
    assign maint_status = channels.maint_status;
    assign maint_failed = channels.maint_failed;
    inst frontend: common_cell::AxiLiteRegisterFrontend::<R> (
        clk  : reg_clk      ,
        rst_n: reg_rst_n    ,
        axi  : cfg          ,
        core : register_port,
    );
    inst control: DmaControl #(
        CHANNEL_COUNT  ,
    ) (
        reg_clk                       ,
        reg_rst_n                     ,
        core_clk                      ,
        core_rst_n                    ,
        cfg            : register_port,
        channels                      ,
        irq                           ,
        fatal_irq                     ,
        fatal                         ,
    );
    inst commands: DmaCommandPath::<B::DATA_WIDTH_BYTES, BURST_BEATS, SLOTS> #(
        CHANNEL_COUNT   ,
        PREFETCH_DEPTH  ,
    ) (
        clk     : core_clk  ,
        rst_n   : core_rst_n,
        channels            ,
        timer_available, timer_value, maint_valid, maint_abort, maint_context, maint_channels,
        memory  : requests  ,
    );
    inst transport: DmaMemoryCrossing::<B::DATA_WIDTH_BYTES, BURST_BEATS, SLOTS> #(
        REQUEST_DEPTH  ,
        RECEIPT_DEPTH  ,
    ) (
        core_clk              ,
        core_rst_n            ,
        bus_clk               ,
        bus_rst_n             ,
        requests    : requests,
        transactions          ,
        fetch_valid           ,
        fetch_ready           ,
        fetch                 ,
    );
    inst endpoint: CopyMemoryEndpoint::<B, BURST_BEATS, SLOTS> #(
        READ_OUTSTANDING   ,
        WRITE_OUTSTANDING  ,
    ) (
        clk        : bus_clk     ,
        rst_n      : bus_rst_n   ,
        port       : transactions,
        fetch_valid              ,
        fetch_ready              ,
        fetch                    ,
        axi        : memory      ,
    );
}
