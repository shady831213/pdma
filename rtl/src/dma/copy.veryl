// Fixed first-slice profile. Atomic capability is off; wider/multichannel profiles follow.
pub module DmaCopy (
    reg_clk   : input   'registers clock                                                          ,
    reg_rst_n : input   'registers reset_async_low                                                ,
    core_clk  : input   'core      clock                                                          ,
    core_rst_n: input   'core      reset_async_low                                                ,
    bus_clk   : input   'bus       clock                                                          ,
    bus_rst_n : input   'bus       reset_async_low                                                ,
    cfg       : modport 'registers $std::axi4_lite_if::<$std::axi4_lite_pkg::<32, 4, 1>>::slave   ,
    memory    : modport 'bus       $std::axi4_if::<CopyMemory::Bus>::master                       ,
    awatop    : output  'bus       logic                                                       <6>,
    irq       : output  'core      logic                                                          ,
    irq_ready : input   'core      logic                                                          ,
    fatal     : output  'core      logic                                                          ,
) {
    var commands          : 'core RegisterState::Ring           [1];
    var events            : 'core RegisterState::Ring           [1];
    var configurations    : 'core RegisterState::ChannelConfig  [1];
    var actions           : 'core RegisterState::ChannelActions [1];
    var statuses          : 'core RegisterState::ChannelStatus  [1];
    var clear             : 'core logic                            ;
    var command_advance   : 'core logic                            ;
    var event_advance     : 'core logic                            ;
    var event_ready       : 'core logic                            ;
    var event_geometry    : 'core logic                            ;
    var global_request    : 'core logic                            ;
    var global_busy       : 'core logic                            ;
    var global_irq_enable : 'core logic                            ;
    var internal_fatal    : 'core logic                            ;
    var fatal_seen        : 'core logic                            ;
    var channel_fatal_seen: 'core logic                            ;
    let channel_failed    : 'core logic                             = statuses[0].fatal != 0;
    inst requests    : 'core CopyMemoryPort;
    inst transactions: 'bus  CopyMemoryPort;
    assign awatop = 0;
    assign fatal  = internal_fatal;
    // Notification is retained until accepted. Enabling later never replays a cause.
    always_ff (core_clk, core_rst_n) {
        if_reset {
            irq                = 0;
            fatal_seen         = 0;
            channel_fatal_seen = 0;
        } else {
            fatal_seen         = fatal;
            channel_fatal_seen = channel_failed;
            if irq_ready || clear {
                irq = 0;
            }
            if global_irq_enable
                && ((fatal && !fatal_seen)
                    || (configurations[0].irq_enable && ((channel_failed && !channel_fatal_seen) || event_advance))) {
                irq = 1;
            }
        }
    }
    always_ff (core_clk, core_rst_n) {
        if_reset {
            global_busy = 0;
        } else if global_request {
            global_busy = 1;
        } else if clear {
            global_busy = 0;
        }
    }
    inst csr: DmaRegisterInterface::<$std::axi4_lite_pkg::<32, 4, 1>> (
        reg_clk                                    ,
        reg_rst_n                                  ,
        core_clk                                   ,
        core_rst_n                                 ,
        axi                  : cfg                 ,
        global_reset_busy    : global_busy         ,
        global_fatal         : fatal               ,
        global_clear         : clear && global_busy,
        global_reset_request : global_request      ,
        global_irq_enable                          ,
        clear_channels       : clear               ,
        maintenance          : 0                   ,
        command_advance                            ,
        event_advance                              ,
        command_advance_ready: _                   ,
        event_advance_ready  : event_ready         ,
        event_geometry                             ,
        statuses                                   ,
        commands                                   ,
        events                                     ,
        configurations                             ,
        actions                                    ,
    );
    inst engine: CopyEngine (
        clk            : core_clk                     ,
        rst_n          : core_rst_n                   ,
        command        : commands[0]                  ,
        events         : events[0]                    ,
        configuration  : configurations[0]            ,
        actions        : actions[0]                   ,
        reset_all      : global_request || global_busy,
        fatal_in       : fatal                        ,
        event_geometry                                ,
        event_ready                                   ,
        status         : statuses[0]                  ,
        clear                                         ,
        command_advance                               ,
        event_advance                                 ,
        internal_fatal                                ,
        memory         : requests                     ,
    );
    inst request_crossing: common_cell::AsyncQueue #(
        TYPE : CopyMemory::Request,
        DEPTH: 8                  ,
    ) (
        s_clk  : core_clk            ,
        s_rst_n: core_rst_n          ,
        s_valid: requests.valid      ,
        s_ready: requests.ready      ,
        s_data : requests.request    ,
        d_clk  : bus_clk             ,
        d_rst_n: bus_rst_n           ,
        d_valid: transactions.valid  ,
        d_ready: transactions.ready  ,
        d_data : transactions.request,
    );
    inst response_crossing: common_cell::AsyncQueue #(
        TYPE : CopyMemory::Receipt,
        DEPTH: 8                  ,
    ) (
        s_clk  : bus_clk              ,
        s_rst_n: bus_rst_n            ,
        s_valid: transactions.returned,
        s_ready: transactions.accepted,
        s_data : transactions.receipt ,
        d_clk  : core_clk             ,
        d_rst_n: core_rst_n           ,
        d_valid: requests.returned    ,
        d_ready: requests.accepted    ,
        d_data : requests.receipt     ,
    );
    inst endpoint: CopyMemoryEndpoint (
        clk  : bus_clk     ,
        rst_n: bus_rst_n   ,
        port : transactions,
        axi  : memory      ,
    );
}
