// Independent ordered AXI lanes. Each accepted internal request owns one receipt;
// software reset closes the producer but never retracts accepted AW/W/AR or R/B.
pub module CopyMemoryEndpoint (
    clk  : input   clock                                   ,
    rst_n: input   reset_async_low                         ,
    port : modport CopyMemoryPort::slave                   ,
    axi  : modport $std::axi4_if::<CopyMemory::Bus>::master,
) {
    inst reads : CopyMemoryPort;
    inst writes: CopyMemoryPort;
    inst lanes : $std::axi4_if::<CopyMemory::Bus>;
    // A full interface joins disjoint read/write views. Passing the already
    // restricted master modport as a different modport is illegal SystemVerilog.
    connect axi            <> lanes.slave;
    assign reads.valid    = port.valid && !port.request.write;
    assign writes.valid   = port.valid && port.request.write;
    assign reads.request  = port.request;
    assign writes.request = port.request;
    assign port.ready     = if port.request.write ? writes.ready : reads.ready;
    inst reader: CopyReadEndpoint (
        clk         ,
        rst_n       ,
        port : reads,
        axi  : lanes,
    );
    inst writer: CopyWriteEndpoint (
        clk          ,
        rst_n        ,
        port : writes,
        axi  : lanes ,
    );
    var cursor  : logic   ;
    var selected: logic<2>;
    var ready   : logic   ;
    assign selected        = common_cell::RoundRobin::<2>::select({writes.returned, reads.returned}, cursor);
    assign reads.accepted  = selected[0] && ready;
    assign writes.accepted = selected[1] && ready;
    // Register the merged receipt; a newly arriving contender cannot replace a
    // receipt already offered under downstream backpressure.
    inst result: common_cell::ReadyValidSlice #(
        TYPE: CopyMemory::Receipt                        ,
        MODE: common_cell::ReadyValid::SliceMode::Forward,
    ) (
        clk                                                      ,
        rst_n                                                    ,
        s_valid : |selected                                      ,
        s_ready : ready                                          ,
        s_data  : if selected[1] ? writes.receipt : reads.receipt,
        m_valid : port.returned                                  ,
        m_ready : port.accepted                                  ,
        m_data  : port.receipt                                   ,
        occupied: _                                              ,
    );
    always_ff (clk, rst_n) {
        if_reset {
            cursor = 0;
        } else if ready && |selected {
            cursor = selected[0];
        }
    }
}
