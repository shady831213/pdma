// Eight resident burst-sized chunks. Every slot keeps its source data until B
// succeeds; fault recovery never rereads a successfully read, unwritten chunk.
// This window belongs to one accepted command, not to the AXI transaction IDs.
module CopyWindow (
    clk                : input   clock                     ,
    rst_n              : input   reset_async_low           ,
    start              : input   logic                     ,
    cancel             : input   logic                     ,
    clear              : input   logic                     ,
    resume             : input   logic                     ,
    source             : input   logic                 <64>,
    destination        : input   logic                 <64>,
    length             : input   logic                 <64>,
    source_context     : input   logic                 <32>,
    destination_context: input   logic                 <32>,
    done               : output  logic                     ,
    drained            : output  logic                     ,
    parked             : output  logic                     ,
    error_code         : output  logic                 <32>,
    error_prefix       : output  logic                 <64>,
    error_ready        : output  logic                     ,
    protocol_error     : output  logic                     ,
    memory             : modport CopyMemoryPort::master    ,
) {
    enum State: logic<3> {
        Free,
        Read,
        Reading,
        Write,
        Writing,
        Done,
    }
    struct Chunk {
        source     : logic<64>,
        destination: logic<64>,
        length     : logic<7> ,
    }
    var states           : State      [8];
    var chunks           : Chunk      [8];
    var active           : logic         ;
    var frozen           : logic         ;
    var recovering       : logic         ;
    var debt             : logic<4>      ;
    var head             : logic<3>      ;
    var tail             : logic<3>      ;
    var next_source      : logic<64>     ;
    var next_destination : logic<64>     ;
    var remaining        : logic<64>     ;
    var committed        : logic<64>     ;
    var available        : logic<8>      ;
    var readable         : logic<8>      ;
    var writable         : logic<8>      ;
    var completed        : logic<8>      ;
    var read_choice      : logic<8>      ;
    var write_choice     : logic<8>      ;
    var read_slot        : logic<3>      ;
    var write_slot       : logic<3>      ;
    var prepared         : logic         ;
    var loading          : logic         ;
    var prepared_data    : logic<512>    ;
    var prepared_slot    : logic<3>      ;
    var portion          : logic<7>      ;
    var amount           : logic<7>      ;
    var failure_successes: logic<8>      ;
    var failure_head     : logic<3>      ;
    let returned_slot    : logic<3>       = (memory.receipt.slot - 1) as 3;
    let receiving        : logic          = memory.returned && memory.accepted;
    let stop_issue       : logic          = cancel || frozen || error_code != 0 || protocol_error
        || (receiving && (memory.receipt.failed || memory.receipt.protocol_error));
    let forward_read     : logic          = receiving && !stop_issue && !prepared && !loading && writable == 0
        && memory.receipt.slot != 0 && memory.receipt.slot <= 8 && states[returned_slot] == State::Reading;
    var selected_slot    : logic<3>      ;
    let retire           : logic          = active && !stop_issue
        && (states[head] == State::Done
            || (receiving && states[head] == State::Writing && memory.receipt.slot == (head as 4) + 1));
    let allocate         : logic          = active && !stop_issue && !recovering && remaining != 0
        && (states[tail] == State::Free || (retire && tail == head));
    let sending          : logic          = memory.valid && memory.ready;
    assign drained = debt == 0;
    assign parked  = active && frozen && drained && !loading && error_code == 0 && !protocol_error;
    assign done    = active && remaining == 0 && (&available) && drained && !frozen && error_code == 0
        && !protocol_error;
    always_comb {
        for i in 0..8 {
            available[i] = states[i] == State::Free;
            readable[i]  = states[i] == State::Read;
            writable[i]  = states[i] == State::Write;
            completed[i] = states[i] == State::Done;
        }
        read_choice  = common_cell::RoundRobin::<8>::select(readable, head);
        write_choice = common_cell::RoundRobin::<8>::select(writable, head);
        read_slot    = 0;
        write_slot   = 0;
        for i in 0..8 {
            if read_choice[i] {
                read_slot = i as 3;
            }
            if write_choice[i] {
                write_slot = i as 3;
            }
        }
        portion = if remaining >= 64 ? 64 : remaining as 7;
        if portion >: 4096 - (next_source[11:0] as u32) {
            portion = (4096 - (next_source[11:0] as u32)) as 7;
        }
        if portion >: 4096 - (next_destination[11:0] as u32) {
            portion = (4096 - (next_destination[11:0] as u32)) as 7;
        }
        amount = if next_source[2:0] == 0 && next_destination[2:0] == 0 && portion >= 8 ? portion & 7'h78 : 1;
    }
    inst buffer_read : common_cell::RamReadPort #( ADDR_WIDTH: 3, WIDTH: 512 );
    inst buffer_write: common_cell::RamWritePort #( ADDR_WIDTH: 3, WIDTH: 512 );
    inst buffers: common_cell::Ram1R1W::<tech_cell_generic::Ram1R1W> #(
        DEPTH: 8  ,
        WIDTH: 512,
    ) (
        clk                     ,
        read_port : buffer_read ,
        write_port: buffer_write,
    );
    assign buffer_read.enable   = active && !stop_issue && !prepared && !loading && (|write_choice);
    assign buffer_read.address  = write_slot;
    assign buffer_write.enable  = receiving && states[returned_slot] == State::Reading && !memory.receipt.failed
        && !memory.receipt.protocol_error;
    assign buffer_write.address = returned_slot;
    assign buffer_write.data    = memory.receipt.data;
    assign buffer_write.mask    = '1;
    always_comb {
        selected_slot           = if prepared ? prepared_slot : if forward_read ? returned_slot : read_slot;
        memory.request          = '0;
        memory.request.slot     = (selected_slot as 4) + 1;
        memory.request.write    = prepared || forward_read;
        memory.request.address  = if memory.request.write ?
            chunks[selected_slot].destination
        :
            chunks[selected_slot].source
        ;
        memory.request.selector = if memory.request.write ? destination_context : source_context;
        memory.request.data     = if forward_read ? memory.receipt.data : prepared_data;
        memory.request.size     = if chunks[selected_slot].length == 1 ? 0 : 3;
        memory.request.length   = if memory.request.size == 0 ? 0 : ((chunks[selected_slot].length >> 3) - 1) as 3;
        memory.valid            = active && !stop_issue && (prepared || forward_read || (|read_choice));
        memory.accepted         = active && debt != 0;
    }
    // One write port from completed R, one synchronous read port feeding a held
    // write offer. No speculative buffer reuse before its successful B receipt.
    always_ff (clk) {
        if loading {
            prepared_data = buffer_read.data;
        }
        if allocate {
            chunks[tail] = Chunk'{source: next_source, destination: next_destination, length: amount};
        }
    }
    always_ff (clk, rst_n) {
        if_reset {
            active            = 0;
            frozen            = 0;
            recovering        = 0;
            debt              = 0;
            head              = 0;
            tail              = 0;
            next_source       = 0;
            next_destination  = 0;
            remaining         = 0;
            committed         = 0;
            prepared          = 0;
            loading           = 0;
            prepared_slot     = 0;
            error_code        = 0;
            error_prefix      = 0;
            error_ready       = 0;
            protocol_error    = 0;
            failure_successes = 0;
            failure_head      = 0;
            states            = '{default: State::Free};
        } else if clear || start {
            active            = start && !clear;
            frozen            = 0;
            recovering        = 0;
            debt              = 0;
            head              = 0;
            tail              = 0;
            next_source       = source;
            next_destination  = destination;
            remaining         = length;
            committed         = 0;
            prepared          = 0;
            loading           = 0;
            error_code        = 0;
            error_prefix      = 0;
            error_ready       = 0;
            protocol_error    = 0;
            failure_successes = 0;
            failure_head      = 0;
            states            = '{default: State::Free};
        } else {
            if done {
                active = 0;
            }
            if parked && resume && !cancel {
                frozen     = 0;
                recovering = 1;
            }
            if recovering && (&available) {
                recovering = 0;
            }
            if buffer_read.enable {
                loading       = 1;
                prepared_slot = write_slot;
            }
            if loading {
                loading  = 0;
                prepared = 1;
            }
            if sending {
                if prepared {
                    states[prepared_slot] = State::Writing;
                    prepared              = 0;
                } else if !forward_read {
                    states[read_slot] = State::Reading;
                }
            }
            case {sending, receiving} {
                2'b10  : debt += 1;
                2'b01  : debt -= 1;
                default: {}
            }
            if receiving {
                if memory.receipt.slot == 0 || memory.receipt.slot >: 8
                    || !(states[returned_slot] == State::Reading || states[returned_slot] == State::Writing)
                    || memory.receipt.protocol_error {
                    protocol_error = 1;
                } else if memory.receipt.failed {
                    states[returned_slot] = if states[returned_slot] == State::Reading ? State::Read : State::Write;
                    if memory.receipt.page_fault {
                        frozen = 1;
                    } else if error_code == 0 {
                        error_code        = if states[returned_slot] == State::Reading ? 2 : 3;
                        failure_successes = completed;
                        failure_head      = head;
                        error_prefix      = committed;
                    }
                } else {
                    states[returned_slot] = if states[returned_slot] == State::Reading ?
                        (if forward_read && sending ? State::Writing : State::Write)
                    :
                        State::Done
                    ;
                }
            }
            // A successful head receipt releases ownership on this edge. Reuse
            // may install new metadata on that same edge; its request is visible
            // next cycle. Later/out-of-order successes still retire through Done.
            if retire {
                committed    += chunks[head].length;
                states[head] =  State::Free;
                head         += 1;
            }
            if allocate {
                states[tail]     =  State::Read;
                tail             += 1;
                next_source      += amount;
                next_destination += amount;
                remaining        -= amount;
            }
            // Error publication may follow drain. Its prefix only uses successes
            // captured at error recognition, never later completion receipts.
            if error_code != 0 && !error_ready {
                if failure_successes[failure_head] {
                    error_prefix                    += chunks[failure_head].length;
                    failure_successes[failure_head] =  0;
                    failure_head                    += 1;
                } else {
                    error_ready = 1;
                }
            }
        }
    }
}
