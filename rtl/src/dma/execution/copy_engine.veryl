// Command owner: Fetch, Decode, Fence and error publication. CopyWindow owns payload progress.
// This initial engine implements Linear Copy and Fence; other valid opcodes stop with an event.
pub module CopyEngine (
    clk            : input   clock                        ,
    rst_n          : input   reset_async_low              ,
    command        : input   RegisterState::Ring          ,
    events         : input   RegisterState::Ring          ,
    configuration  : input   RegisterState::ChannelConfig ,
    actions        : input   RegisterState::ChannelActions,
    reset_all      : input   logic                        ,
    fatal_in       : input   logic                        ,
    event_geometry : input   logic                        ,
    event_ready    : input   logic                        ,
    status         : output  RegisterState::ChannelStatus ,
    clear          : output  logic                        ,
    command_advance: output  logic                        ,
    event_advance  : output  logic                        ,
    internal_fatal : output  logic                        ,
    memory         : modport CopyMemoryPort::master       ,
) {
    enum Phase: logic<4> {
        Idle,
        Fetch,
        FetchReturn,
        Decode,
        Copy,
        FenceWrite,
        FenceReturn,
        ParkFence,
        Publish,
        PublishReturn,
        Stopped,
    }
    var phase             : Phase     ;
    var closing           : logic     ;
    var descriptor        : logic<768>;
    var fetched           : logic<7>  ;
    var descriptor_address: logic<64> ;
    var fence_address     : logic<64> ;
    var error_prefix      : logic<64> ;
    var fence_data        : logic<512>;
    var error_code        : logic<32> ;
    var stopped           : logic     ;
    var channel_fatal     : logic<32> ;
    var bug               : logic     ;
    var fetch_amount      : logic<7>  ;
    var event_offset      : logic<5>  ;
    var event_amount      : logic<5>  ;
    var copy_drained      : logic     ;
    let shutdown          : logic      = closing || actions.reset_request || reset_all;
    let waiting           : logic      = phase == Phase::FetchReturn || phase == Phase::FenceReturn || phase
        == Phase::PublishReturn || (phase == Phase::Copy && !copy_drained);
    let source_sum        : logic<65>  = (descriptor[319:256] as 65) + (descriptor[383:320] as 65);
    let destination_sum   : logic<65>  = (descriptor[575:512] as 65) + (descriptor[639:576] as 65);
    let source_end        : logic<65>  = source_sum + (descriptor[191:128] as 65);
    let destination_end   : logic<65>  = destination_sum + (descriptor[191:128] as 65);
    let fence             : logic      = descriptor[7:0] == 6;
    let fence_bytes       : logic<7>   = if descriptor[255:224] == 0 ? 4 : 8;
    let fence_end         : logic<65>  = (descriptor[191:128] as 65) + (fence_bytes as 65);
    let fetch_address     : logic<64>  = descriptor_address + fetched;
    let descriptor_start  : logic<65>  = (command.base as 65) + ((command.consumer & (command.capacity - 1)) as 65)
        * CommandLayout::EXTENT;
    let descriptor_end    : logic<65>  = descriptor_start + CommandLayout::EXTENT;
    let event_start       : logic<65>  = (events.base as 65) + ((events.producer & (events.capacity - 1)) as 65)
        * EventLayout::EXTENT;
    let event_end         : logic<65>  = event_start + EventLayout::EXTENT;
    let event_address     : logic<64>  = (event_start as 64) + event_offset;
    inst control: CopyMemoryPort;
    inst payload: CopyMemoryPort;
    var copy_start         : logic    ;
    var copy_done          : logic    ;
    var copy_parked        : logic    ;
    var copy_error         : logic<32>;
    var copy_prefix        : logic<64>;
    var copy_error_ready   : logic    ;
    var copy_protocol_error: logic    ;
    let copying            : logic     = phase == Phase::Copy;
    assign memory.valid     = if copying ? payload.valid : control.valid;
    assign memory.request   = if copying ? payload.request : control.request;
    assign memory.accepted  = if copying ? payload.accepted : control.accepted;
    assign control.ready    = memory.ready && !copying;
    assign payload.ready    = memory.ready && copying;
    assign control.returned = memory.returned && !copying;
    assign payload.returned = memory.returned && copying;
    assign control.receipt  = memory.receipt;
    assign payload.receipt  = memory.receipt;
    inst copy: CopyWindow (
        clk                                        ,
        rst_n                                      ,
        start              : copy_start            ,
        cancel             : shutdown || fatal_in,
        clear                                      ,
        resume             : actions.resume_request,
        source             : source_sum as 64      ,
        destination        : destination_sum as 64 ,
        length             : descriptor[191:128]   ,
        source_context     : descriptor[223:192]   ,
        destination_context: descriptor[255:224]   ,
        done               : copy_done             ,
        drained            : copy_drained          ,
        parked             : copy_parked           ,
        error_code         : copy_error            ,
        error_prefix       : copy_prefix           ,
        error_ready        : copy_error_ready      ,
        protocol_error     : copy_protocol_error   ,
        memory             : payload               ,
    );
    assign internal_fatal   = bug;
    assign status           = RegisterState::ChannelStatus'{
        resetting: closing                                                           ,
        fatal    : channel_fatal                                                     ,
        faulted  : phase == Phase::ParkFence || (phase == Phase::Copy && copy_parked),
        error    : stopped || (phase == Phase::Copy && copy_error != 0),
        trap     : 0                                                                 ,
    };
    assign clear            = closing && !waiting;
    assign command_advance  = phase == Phase::Decode && !shutdown && descriptor[7:0] <= 8 && descriptor[15:10] == 0;
    assign event_advance    = phase == Phase::PublishReturn && control.returned && !control.receipt.failed
        && !control.receipt.protocol_error && !shutdown && event_offset + event_amount == EventLayout::EXTENT;
    assign control.accepted = waiting && phase != Phase::Copy;
    always_comb {
        fetch_amount = if fetched <= 32 ? 64 : (96 - fetched) as 7;
        if fetch_amount >: 4096 - (fetch_address[11:0] as u32) {
            fetch_amount = (4096 - (fetch_address[11:0] as u32)) as 7;
        }
        event_amount = (EventLayout::EXTENT - event_offset) as 5;
        if event_amount >: 4096 - (event_address[11:0] as u32) {
            event_amount = (4096 - (event_address[11:0] as u32)) as 5;
        }
        control.request = CopyMemory::Request'{
            slot           : 0                                                    ,
            write          : phase == Phase::FenceWrite || phase == Phase::Publish,
            address        : fence_address                                        ,
            selector       : descriptor[223:192]                                  ,
            size           : if fence_bytes == 4 ? 2 : 3,
            length         : 0                                                    ,
            data           : fence_data                                           ,
        };
        if phase == Phase::Fetch {
            control.request.address  = fetch_address;
            control.request.selector = configuration.ring_context;
            control.request.size     = 3;
            control.request.length   = ((fetch_amount >> 3) - 1) as 3;
        }
        if phase == Phase::Publish {
            control.request.address  = event_address;
            control.request.selector = configuration.ring_context;
            control.request.size     = 3;
            control.request.length   = ((event_amount >> 3) - 1) as 3;
            control.request.data     = ((descriptor[127:64] as 512) | ((error_code as 512) << 64)
                    | ((error_prefix as 512) << 128)) >> (event_offset * 8);
        }
        control.valid = !shutdown && !fatal_in
            && (phase == Phase::Fetch || phase == Phase::FenceWrite
                || (phase == Phase::Publish && event_geometry && event_ready && !event_end[64]));
    }
    always_ff (clk, rst_n) {
        if_reset {
            phase              = Phase::Idle;
            closing            = 0;
            descriptor         = 0;
            fetched            = 0;
            descriptor_address = 0;
            fence_address      = 0;
            error_prefix       = 0;
            fence_data         = 0;
            error_code         = 0;
            stopped            = 0;
            channel_fatal      = 0;
            bug                = 0;
            event_offset       = 0;
            copy_start         = 0;
        } else {
            copy_start = 0;
            if actions.reset_request || reset_all {
                closing = 1;
            }
            if clear {
                closing       = 0;
                phase         = Phase::Idle;
                descriptor    = 0;
                fetched       = 0;
                error_prefix  = 0;
                fence_data    = 0;
                stopped       = 0;
                channel_fatal = 0;
                event_offset  = 0;
                // Device fatal is cleared only by the DMA-wide lifecycle owner.
                if reset_all {
                    bug = 0;
                }
            } else if shutdown {
                if phase == Phase::Copy {
                    if copy_drained {
                        phase = Phase::Idle;
                    }
                } else if !waiting || control.returned {
                    phase = Phase::Idle;
                }
            } else if waiting && control.returned && control.receipt.protocol_error {
                bug   = 1;
                phase = Phase::Stopped;
            } else {
                case phase {
                    Phase::Idle       : if configuration.enable && !fatal_in && !stopped && channel_fatal == 0
                        && command.producer != command.consumer {
                        descriptor_address = descriptor_start as 64;
                        fetched            = 0;
                        descriptor         = 0;
                        error_prefix       = 0;
                        event_offset       = 0;
                        if descriptor_end[64] {
                            channel_fatal = ChannelRecoveryLayout::FATAL_CODE_COMMANDREAD as 32;
                            phase         = Phase::Stopped;
                        } else {
                            phase = Phase::Fetch;
                        }
                    }
                    Phase::Fetch      : if control.ready && control.valid {
                        phase = Phase::FetchReturn;
                    }
                    Phase::FetchReturn: if control.returned {
                        if control.receipt.failed {
                            channel_fatal = ChannelRecoveryLayout::FATAL_CODE_COMMANDREAD as 32;
                            phase         = Phase::Stopped;
                        } else {
                            descriptor = descriptor | ((control.receipt.data as 768) << (fetched * 8));
                            if fetched + fetch_amount == 96 {
                                phase = Phase::Decode;
                            } else {
                                fetched += fetch_amount;
                                phase   =  Phase::Fetch;
                            }
                        }
                    }
                    Phase::Decode     : {
                        if descriptor[7:0] >: 8 || descriptor[15:10] != 0 {
                            channel_fatal = ChannelRecoveryLayout::FATAL_CODE_COMMANDREAD as 32;
                            phase         = Phase::Stopped;
                        } else if fence {
                            if descriptor[255:224] >: 1 {
                                channel_fatal = ChannelRecoveryLayout::FATAL_CODE_COMMANDREAD as 32;
                                phase         = Phase::Stopped;
                            } else if descriptor[129:128] != 0 || (fence_bytes == 8 && descriptor[130])
                                || fence_end[64] {
                                error_code = 7;
                                stopped    = 1;
                                phase      = Phase::Publish;
                            } else {
                                fence_address = descriptor[191:128];
                                fence_data    = descriptor[319:256] as 512;
                                phase         = Phase::FenceWrite;
                            }
                        } else if descriptor[7:0] != 0 || descriptor[9:8] != 0 {
                            error_code = 6;
                            stopped    = 1;
                            phase      = Phase::Publish;
                        } else if descriptor[191:128] == 0 {
                            phase = Phase::Idle;
                        } else if source_sum[64] || destination_sum[64] || source_end[64] || destination_end[64] {
                            error_code = 1;
                            stopped    = 1;
                            phase      = Phase::Publish;
                        } else {
                            phase      = Phase::Copy;
                            copy_start = 1;
                        }
                    }
                    Phase::Copy: {
                        if copy_protocol_error {
                            bug = 1;
                        }
                        if copy_protocol_error && copy_drained {
                            phase = Phase::Stopped;
                        } else if copy_error != 0 && copy_error_ready && copy_drained {
                            error_prefix = copy_prefix;
                            error_code   = copy_error;
                            stopped      = 1;
                            phase        = Phase::Publish;
                        } else if copy_done {
                            phase = Phase::Idle;
                        }
                    }
                    Phase::FenceWrite : if control.ready && control.valid {
                        phase = Phase::FenceReturn;
                    }
                    Phase::FenceReturn: if control.returned {
                        if control.receipt.failed {
                            if control.receipt.page_fault {
                                phase = Phase::ParkFence;
                            } else {
                                error_code = 3;
                                stopped    = 1;
                                phase      = Phase::Publish;
                            }
                        } else {
                            phase = Phase::Idle;
                        }
                    }
                    Phase::ParkFence  : if actions.resume_request {
                        phase = Phase::FenceWrite;
                    }
                    Phase::Publish    : {
                        if !event_geometry || event_end[64] {
                            channel_fatal = ChannelRecoveryLayout::FATAL_CODE_EVENTCONFIGURATION as 32;
                            phase         = Phase::Stopped;
                        } else if !event_ready {
                            channel_fatal = ChannelRecoveryLayout::FATAL_CODE_EVENTFULL as 32;
                            phase         = Phase::Stopped;
                        } else if control.valid && control.ready {
                            phase = Phase::PublishReturn;
                        }
                    }
                    Phase::PublishReturn: if control.returned {
                        if control.receipt.failed {
                            channel_fatal = ChannelRecoveryLayout::FATAL_CODE_EVENTWRITE as 32;
                            phase         = Phase::Stopped;
                        } else if event_offset + event_amount == EventLayout::EXTENT {
                            phase = Phase::Stopped;
                        } else {
                            event_offset += event_amount;
                            phase        =  Phase::Publish;
                        }
                    }
                    Phase::Stopped      : {}
                }
            }
        }
    }
}
