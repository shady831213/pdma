// Copy/Fence/Trap engine; private accepted-command and retained-data state.
// Another execution engine can implement the same channel and memory ports.
pub module CopyEngine::<DATA_BYTES: u32 = 8, BURST_BEATS: u32 = 8, SLOTS: u32 = 8> #(
    param CHANNEL_COUNT: u32 = 1,
) (
    clk       : input   clock                                                                                  ,
    rst_n     : input   reset_async_low                                                                        ,
    heads     : input   CommandState::Entry                                                     [CHANNEL_COUNT],
    head_valid: input   logic                                                   <CHANNEL_COUNT>                ,
    fetching  : input   logic                                                   <CHANNEL_COUNT>                ,
    channels  : modport DmaChannels::engine                                                                    ,
    memory    : modport CopyMemoryPort::<DATA_BYTES, BURST_BEATS, SLOTS>::master                               ,
) {
    alias package M = CopyMemory::<DATA_BYTES, BURST_BEATS, SLOTS>;
    const OP_COPY: u8 = 0;
    const OP_FENCE: u8 = 6;
    const OP_TRAP: u8 = 7;
    const CONTROL_SIZE   : u32                                                    = if M::DATA_SIZE <: 3 ?
        M::DATA_SIZE
    :
        3
    ;
    const CONTROL_BYTES  : u32                                                    = (1 << CONTROL_SIZE) * BURST_BEATS;
    var   contexts       : CommandState::Context                  [CHANNEL_COUNT];
    var   closing        : logic                <CHANNEL_COUNT>                  ;
    var   shutdown       : logic                <CHANNEL_COUNT>                  ;
    var   locked         : logic                                                 ;
    var   owner          : M::Channel                                            ;
    var   cursor         : M::Channel                                            ;
    var   eligible       : logic                <M::MAX_CHANNELS>                ;
    var   choice         : logic                <M::MAX_CHANNELS>                ;
    var   chosen         : M::Channel                                            ;
    var   selected       : M::Channel                                            ;
    var   selected_valid : logic                                                 ;
    var   bug            : logic                                                 ;
    var   next           : CommandState::Context                                 ;
    var   release_owner  : logic                                                 ;
    let   current        : CommandState::Context                                  = contexts[selected];
    let   descriptor     : logic                <768>                             = if current.phase
        == CommandState::Phase::Idle ?
        heads[selected].descriptor
    :
        current.descriptor
    ;
    let   fence_data     : logic                <M::BURST_BITS>                   = descriptor[319:256] as M::BURST_BITS;
    let   source_sum     : logic                <65>                              = (descriptor[319:256] as 65)
        + (descriptor[383:320] as 65);
    let   destination_sum: logic                <65>                              = (descriptor[575:512] as 65)
        + (descriptor[639:576] as 65);
    let   source_end     : logic                <65>                              = source_sum
        + (descriptor[191:128] as 65);
    let   destination_end: logic                <65>                              = destination_sum
        + (descriptor[191:128] as 65);
    let opcode: logic<8> = descriptor[7:0];
    // Decode and acceptance share the same reserved-byte checks.
    let encoding_valid: logic = case opcode {
        OP_COPY: descriptor[15:10] == 0 && descriptor[31:16] == 0
            && (descriptor[8] || descriptor[511:384] == 0) && (descriptor[9] || descriptor[767:640] == 0),
        OP_FENCE: descriptor[63:8] == 0 && descriptor[255:224] <= 1 && descriptor[767:320] == 0,
        OP_TRAP: descriptor[63:8] == 0 && descriptor[767:TrapCommandLayout::EXTENT * 8] == 0,
        default: opcode <= 8 && descriptor[63:8] == 0,
    };
    let fence_bytes         : logic<7>                             = if descriptor[255:224] == 0 ? 4 : 8;
    let fence_end           : logic<65>                            = (descriptor[191:128] as 65) + (fence_bytes as 65);
    let event_start         : logic<65>                            = (channels.events[selected].base as 65)
        + ((channels.events[selected].producer & (channels.events[selected].capacity - 1)) as 65) * EventLayout::EXTENT;
    let event_end           : logic<65>                            = event_start + EventLayout::EXTENT;
    let owner_return        : logic                                = memory.returned && memory.accepted
        && !memory.receipt.orphan && memory.receipt.tag.channel == selected;
    let control_return      : logic                                = owner_return && memory.receipt.tag.slot
        == M::CONTROL_SLOT;
    let protocol_failure    : logic                                = memory.returned && memory.receipt.protocol_error;
    let globally_stopped    : logic                                = channels.fatal_in || protocol_failure
        || channels.global_blocked;
    var event_amount        : logic<5>                            ;
    var copy_start          : logic<CHANNEL_COUNT>                ;
    var copy_cancel         : logic<CHANNEL_COUNT>                ;
    var copy_done           : logic<CHANNEL_COUNT>                ;
    var copy_drained        : logic<CHANNEL_COUNT>                ;
    var copy_parked         : logic<CHANNEL_COUNT>                ;
    var copy_error          : logic<32>            [CHANNEL_COUNT];
    var copy_prefix         : logic<64>            [CHANNEL_COUNT];
    var copy_error_ready    : logic<CHANNEL_COUNT>                ;
    var copy_protocol_error : logic<CHANNEL_COUNT>                ;
    var resumes             : logic<CHANNEL_COUNT>                ;
    inst payload: CopyMemoryPort::<DATA_BYTES, BURST_BEATS, SLOTS>;
    let copying: logic = selected_valid && current.phase == CommandState::Phase::Copy;
    let segmented: logic = descriptor[9:8] != 0;
    var segment_debt: logic<CHANNEL_COUNT>;
    var span_ready: logic;
    var span_last: logic;
    var span_source: u64;
    var span_destination: u64;
    var span_length: u64;
    var span_prefix: u64;
    var segment_error: u32;
    inst metadata: CopyMemoryPort::<DATA_BYTES,BURST_BEATS,SLOTS>;
    let walking: logic = selected_valid && current.phase == CommandState::Phase::WalkSegments
        && !shutdown[selected] && !globally_stopped;
    assign metadata.ready = memory.ready && channels.configuration[selected].enable;
    assign metadata.receipt = memory.receipt;
    assign metadata.returned = memory.returned && !memory.receipt.orphan
        && memory.receipt.tag.slot == M::CONTROL_SLOT;
    inst segments: CopySegments::<DATA_BYTES,BURST_BEATS,SLOTS> #(CHANNEL_COUNT) (
        clk, rst_n, selected, descriptor, walk: walking,
        start: channels.command_advance[selected] && opcode == OP_COPY && segmented && descriptor[191:128] != 0,
        cancel: copy_cancel, clear: channels.clear,
        span_done: copying && segmented && copy_done[selected] && !copy_cancel[selected],
        waiting: segment_debt, offer: span_ready, last: span_last, prefix: span_prefix,
        source: span_source, destination: span_destination, length: span_length,
        error_code: segment_error, memory: metadata,
    );
    assign payload.ready    = memory.ready && copying && channels.configuration[selected].enable && !globally_stopped;
    assign payload.returned = memory.returned && memory.receipt.tag.slot != 0 && memory.receipt.tag.slot <= SLOTS
        && !memory.receipt.orphan;
    assign payload.receipt  = memory.receipt;
    inst copy: CopyWindow::<DATA_BYTES, BURST_BEATS, SLOTS> #(
        CHANNEL_COUNT  ,
    ) (
        clk                                       ,
        rst_n                                     ,
        selected                                  ,
        selected_valid     : copying              ,
        start              : copy_start           ,
        cancel             : copy_cancel          ,
        clear              : channels.clear       ,
        resume             : resumes              ,
        source             : if segmented ? span_source : source_sum as 64     ,
        destination        : if segmented ? span_destination : destination_sum as 64,
        length             : if segmented ? span_length : descriptor[191:128]  ,
        source_context     : descriptor[223:192]  ,
        destination_context: descriptor[255:224]  ,
        done               : copy_done            ,
        drained            : copy_drained         ,
        parked             : copy_parked          ,
        error_code         : copy_error           ,
        error_prefix       : copy_prefix          ,
        error_ready        : copy_error_ready     ,
        protocol_error     : copy_protocol_error  ,
        memory             : payload              ,
    );
    assign channels.internal_fatal = bug;
    always_comb {
        eligible = 0;
        for channel in 0..CHANNEL_COUNT {
            shutdown[channel]        = closing[channel] || channels.actions[channel].reset_request
                || channels.reset_all;
            copy_cancel[channel]     = shutdown[channel] || channels.fatal_in || protocol_failure;
            resumes[channel]         = channels.actions[channel].resume_request;
            channels.clear[channel]  = closing[channel] && !CommandState::waiting(contexts[channel].phase)
                && copy_drained[channel] && !fetching[channel] && !segment_debt[channel];
            channels.status[channel] = RegisterState::ChannelStatus'{
                resetting               : closing[channel]       ,
                fatal                   : contexts[channel].fatal,
                faulted                 : contexts[channel].phase == CommandState::Phase::ParkFence
                    || (contexts[channel].phase == CommandState::Phase::Copy && copy_parked[channel]),
                error: contexts[channel].stopped
                    || (contexts[channel].phase == CommandState::Phase::Copy && copy_error[channel] != 0),
            };
            eligible[channel] = !globally_stopped && !shutdown[channel] && channels.configuration[channel].enable
                && !contexts[channel].stopped && contexts[channel].fatal == 0
                && ((contexts[channel].phase == CommandState::Phase::Idle && head_valid[channel])
                    || (contexts[channel].phase == CommandState::Phase::Copy && !copy_parked[channel])
                    || contexts[channel].phase == CommandState::Phase::WalkSegments
                    || contexts[channel].phase == CommandState::Phase::FenceWrite);
        }
        choice = common_cell::RoundRobin::<CopyMemory::MAX_CHANNELS>::select(eligible, cursor);
        chosen = common_cell::BoundedIndex::<CopyMemory::MAX_CHANNELS>::encode_onehot(choice);
        // Arbitration hands off a registered owner before address/decode work.
        selected        = owner;
        selected_valid  = locked;
        memory.accepted = memory.receipt.orphan;
        if memory.returned && !memory.receipt.orphan && (memory.receipt.tag.channel as u32) <: CHANNEL_COUNT {
            memory.accepted = if memory.receipt.tag.slot == M::CONTROL_SLOT ?
                CommandState::waiting(contexts[memory.receipt.tag.channel].phase) || metadata.accepted
            :
                payload.accepted
            ;
        }
        channels.trap_executed   = 0;
        channels.command_advance = 0;
        channels.event_advance   = 0;
        if selected_valid && !shutdown[selected] && !globally_stopped {
            channels.command_advance[selected] = channels.configuration[selected].enable && current.phase
                == CommandState::Phase::Idle && head_valid[selected] && !heads[selected].failed && encoding_valid;
            channels.trap_executed[selected] = channels.command_advance[selected] && opcode == OP_TRAP;
            channels.event_advance[selected]   = current.phase == CommandState::Phase::PublishReturn && control_return
                && !memory.receipt.failed && !memory.receipt.protocol_error && current.event_offset + event_amount
                == EventLayout::EXTENT;
        }
    }
    always_comb {
        event_amount = if EventLayout::EXTENT - current.event_offset >= CONTROL_BYTES ?
            CONTROL_BYTES
        :
            (EventLayout::EXTENT - current.event_offset) as 5
        ;
        if event_amount >: 4096 - (current.control_address[11:0] as u32) {
            event_amount = (4096 - (current.control_address[11:0] as u32)) as 5;
        }
        memory.request = M::Request'{
            tag           : M::Tag'{channel: selected, slot: M::CONTROL_SLOT as M::SLOT_BITS},
            write         : current.phase == CommandState::Phase::FenceWrite || current.phase
                == CommandState::Phase::Publish,
            address : current.control_address                                                                          ,
            selector: descriptor[223:192]                                                                              ,
            size    : if fence_bytes == 4 ? 2 : CONTROL_SIZE,
            length  : (if fence_bytes == 8 && DATA_BYTES == 4 ? 1 : 0)                                                 ,
            data    : fence_data                                                                                       ,
        };
        if current.phase == CommandState::Phase::Publish {
            memory.request.selector = channels.configuration[selected].ring_context;
            memory.request.size     = CONTROL_SIZE;
            memory.request.length   = ((event_amount >> CONTROL_SIZE) - 1) as M::LENGTH_BITS;
            memory.request.data     = (((descriptor[127:64] as 192) | ((current.error_code as 192) << 64)
                    | ((current.error_prefix as 192) << 128)) >> (current.event_offset * 8)) as M::BURST_BITS;
        }
        memory.valid = selected_valid && channels.configuration[selected].enable && !shutdown[selected]
            && !globally_stopped
            && (current.phase == CommandState::Phase::FenceWrite
                || (current.phase == CommandState::Phase::Publish && channels.event_geometry[selected]
                    && channels.event_ready[selected]));
        if walking {
            memory.request = metadata.request;
            memory.valid = metadata.valid && channels.configuration[selected].enable;
        }
        if copying {
            memory.request = payload.request;
            memory.valid   = payload.valid && channels.configuration[selected].enable && !globally_stopped;
        }
    }
    always_comb {
        next = current;
        if shutdown[selected] {
            if !CommandState::waiting(current.phase) || control_return {
                next.phase = CommandState::Phase::Idle;
            }
        } else if control_return && memory.receipt.protocol_error {
            next.phase = CommandState::Phase::Stopped;
        } else {
            case current.phase {
                CommandState::Phase::Idle: if selected_valid && !globally_stopped
                    && channels.configuration[selected].enable && head_valid[selected] {
                    next.descriptor   = descriptor;
                    next.error_prefix = 0;
                    next.event_offset = 0;
                    if heads[selected].failed || !encoding_valid {
                        next.fatal = ChannelRecoveryLayout::FATAL_CODE_COMMANDREAD as 32;
                        next.phase = CommandState::Phase::Stopped;
                    } else if opcode == OP_TRAP {
                        next.phase = CommandState::Phase::Idle;
                    } else if opcode == OP_FENCE {
                        if descriptor[129:128] != 0 || (fence_bytes == 8 && descriptor[130]) || fence_end[64] {
                            next.error_code = 7;
                            next.stopped    = 1;
                            next.phase      = CommandState::Phase::PrepareEvent;
                        } else {
                            next.control_address = descriptor[191:128];
                            next.phase           = CommandState::Phase::FenceWrite;
                        }
                    } else if opcode != OP_COPY {
                        next.error_code = 6;
                        next.stopped    = 1;
                        next.phase      = CommandState::Phase::PrepareEvent;
                    } else if descriptor[191:128] == 0 {
                        next.phase = CommandState::Phase::Idle;
                    } else if segmented {
                        next.phase = CommandState::Phase::WalkSegments;
                    } else if source_sum[64] || destination_sum[64] || source_end[64] || destination_end[64] {
                        next.error_code = 1;
                        next.stopped    = 1;
                        next.phase      = CommandState::Phase::PrepareEvent;
                    } else {
                        next.phase = CommandState::Phase::Copy;
                    }
                }
                CommandState::Phase::WalkSegments: {
                    if segment_error != 0 {
                        next.error_code = segment_error;
                        next.error_prefix = span_prefix;
                        next.stopped = 1;
                        next.phase = CommandState::Phase::PrepareEvent;
                    } else if span_ready {
                        next.phase = CommandState::Phase::Copy;
                    }
                }
                CommandState::Phase::Copy: {
                    if copy_protocol_error[selected] && copy_drained[selected] {
                        next.phase = CommandState::Phase::Stopped;
                    } else if copy_error[selected] != 0 && copy_error_ready[selected] && copy_drained[selected] {
                        next.error_prefix = copy_prefix[selected] + (if segmented ? span_prefix : 0);
                        next.error_code   = copy_error[selected];
                        next.stopped      = 1;
                        next.phase        = CommandState::Phase::PrepareEvent;
                    } else if copy_done[selected] {
                        next.phase = if segmented && !span_last ? CommandState::Phase::WalkSegments : CommandState::Phase::Idle;
                    }
                }
                CommandState::Phase::FenceWrite : if memory.valid && memory.ready {
                    next.phase = CommandState::Phase::FenceReturn;
                }
                CommandState::Phase::FenceReturn: if control_return {
                    if memory.receipt.failed {
                        if memory.receipt.page_fault {
                            next.phase = CommandState::Phase::ParkFence;
                        } else {
                            next.error_code = 3;
                            next.stopped    = 1;
                            next.phase      = CommandState::Phase::PrepareEvent;
                        }
                    } else {
                        next.phase = CommandState::Phase::Idle;
                    }
                }
                CommandState::Phase::ParkFence  : {}
                CommandState::Phase::PrepareEvent: {
                    if !channels.event_geometry[selected] || event_end[64] {
                        next.fatal = ChannelRecoveryLayout::FATAL_CODE_EVENTCONFIGURATION as 32;
                        next.phase = CommandState::Phase::Stopped;
                    } else if !channels.event_ready[selected] {
                        next.fatal = ChannelRecoveryLayout::FATAL_CODE_EVENTFULL as 32;
                        next.phase = CommandState::Phase::Stopped;
                    } else {
                        next.control_address = event_start as 64;
                        next.phase           = CommandState::Phase::Publish;
                    }
                }
                CommandState::Phase::Publish: {
                    if !channels.event_geometry[selected] {
                        next.fatal = ChannelRecoveryLayout::FATAL_CODE_EVENTCONFIGURATION as 32;
                        next.phase = CommandState::Phase::Stopped;
                    } else if !channels.event_ready[selected] {
                        next.fatal = ChannelRecoveryLayout::FATAL_CODE_EVENTFULL as 32;
                        next.phase = CommandState::Phase::Stopped;
                    } else if memory.valid && memory.ready {
                        next.phase = CommandState::Phase::PublishReturn;
                    }
                }
                CommandState::Phase::PublishReturn: if control_return {
                    if memory.receipt.failed {
                        next.fatal = ChannelRecoveryLayout::FATAL_CODE_EVENTWRITE as 32;
                        next.phase = CommandState::Phase::Stopped;
                    } else if current.event_offset + event_amount == EventLayout::EXTENT {
                        next.phase = CommandState::Phase::Stopped;
                    } else {
                        next.event_offset    = current.event_offset + event_amount;
                        next.control_address = current.control_address + event_amount;
                        next.phase           = CommandState::Phase::Publish;
                    }
                }
                CommandState::Phase::Stopped      : {}
            }
        }
        release_owner = shutdown[selected] || globally_stopped || next.phase == CommandState::Phase::Idle || next.phase
            == CommandState::Phase::Stopped || next.phase == CommandState::Phase::ParkFence
            || (current.phase == CommandState::Phase::Copy && copy_parked[selected]);
    }
    always_ff (clk, rst_n) {
        if_reset {
            locked     = 0;
            owner      = 0;
            cursor     = 0;
            bug        = 0;
            contexts   = '{default: CommandState::EMPTY};
            closing    = 0;
            copy_start = 0;
        } else {
            copy_start = 0;
            if channels.global_clear {
                bug = 0;
            } else if protocol_failure || (|copy_protocol_error) {
                bug = 1;
            }
            if !locked && (|choice) {
                owner  = chosen;
                cursor = if (chosen as u32) + 1 >= CHANNEL_COUNT ? 0 : chosen + 1;
                locked = 1;
            } else if locked {
                locked = !release_owner;
            }
            for channel in 0..CHANNEL_COUNT {
                if channels.actions[channel].reset_request || channels.reset_all {
                    closing[channel] = 1;
                }
                if channels.clear[channel] {
                    contexts[channel] = CommandState::EMPTY;
                    // A new reset scope wins over the old cleanup acknowledgement.
                    // Global collection starts at this edge and must still see
                    // this owner's acknowledgement on the following cycle.
                    closing[channel] = channels.actions[channel].reset_request || channels.reset_all;
                } else if selected_valid && selected == channel {
                    contexts[channel] = next;
                    if (current.phase == CommandState::Phase::Idle || current.phase == CommandState::Phase::WalkSegments) && next.phase == CommandState::Phase::Copy
                        && !shutdown[channel] && !globally_stopped {
                        copy_start[channel] = 1;
                    }
                } else if memory.returned && memory.accepted && !memory.receipt.orphan && memory.receipt.tag.slot
                    == M::CONTROL_SLOT && memory.receipt.tag.channel == channel {
                    // Only closing/fatal owners can have a control return after
                    // yielding. The terminal receipt discharges that obligation.
                    contexts[channel].phase = CommandState::Phase::Idle;
                }
                if contexts[channel].phase == CommandState::Phase::ParkFence && channels.actions[channel].resume_request
                    && !shutdown[channel] && !channels.clear[channel] {
                    contexts[channel].phase = CommandState::Phase::FenceWrite;
                }
            }
        }
    }
}
