// PDMA address identity and response-reason encodings on the ordinary AXI port.
pub module CopyMemoryEndpoint::<
    B          : $std::axi4_prototype = $std::axi4_pkg::<64, 8, 1, 35, 1, 2, 35, 2>,
    BURST_BEATS: u32                  = 8                  ,
    SLOTS      : u32                  = 8                  ,
> #(
    param READ_OUTSTANDING : u32 = 8,
    param WRITE_OUTSTANDING: u32 = 8,
) (
    clk  : input   clock                                                           ,
    rst_n: input   reset_async_low                                                 ,
    port : modport CopyMemoryPort::<B::DATA_WIDTH_BYTES, BURST_BEATS, SLOTS>::slave,
    axi  : modport $std::axi4_if::<B>::master                                      ,
) {
    alias package M = CopyMemory::<B::DATA_WIDTH_BYTES, BURST_BEATS, SLOTS>;
    const REASON_BITS: u32 = if B::RUSER_LENGTH >: B::BUSER_LENGTH ? B::RUSER_LENGTH : B::BUSER_LENGTH;
    inst bus_port: common_cell::BurstPort::<B::ADDRESS_WIDTH, B::DATA_WIDTH_BYTES, BURST_BEATS, M::TAG_BITS, M::USER_BITS>;
    assign bus_port.valid              = port.valid;
    assign port.ready                  = bus_port.ready;
    assign bus_port.request.tag        = port.request.tag as M::TAG_BITS;
    assign bus_port.request.write      = port.request.write;
    assign bus_port.request.address    = port.request.address;
    assign bus_port.request.attributes = {port.request.tag.channel, port.request.selector};
    assign bus_port.request.size       = port.request.size;
    assign bus_port.request.length     = port.request.length;
    assign bus_port.request.data       = port.request.data;
    assign port.returned               = bus_port.returned;
    assign bus_port.accepted           = port.accepted;
    assign port.receipt                = M::Receipt'{
        tag           : bus_port.receipt.tag as M::Tag ,
        data          : bus_port.receipt.data          ,
        failed        : bus_port.receipt.failed        ,
        page_fault    : bus_port.receipt.retryable     ,
        protocol_error: bus_port.receipt.protocol_error,
    };
    function attributes (
        resp          : input logic<2>                                         ,
        reason        : input logic<REASON_BITS>                               ,
    ) -> common_cell::AxiResponse::Attributes {
        return common_cell::AxiResponse::Attributes'{
            retryable: reason == 1 && resp >= 2,
            invalid  : reason != 0 && (reason != 1 || resp <: 2),
        };
    }
    inst master: common_cell::AxiMemoryMaster::<B, BURST_BEATS, M::TAG_BITS, M::USER_BITS> #(
        READ_OUTSTANDING   ,
        WRITE_OUTSTANDING  ,
    ) (
        clk                                                                   ,
        rst_n                                                                 ,
        port            : bus_port                                            ,
        axi                                                                   ,
        read_attributes : attributes(axi.rresp as 2, axi.ruser as REASON_BITS),
        write_attributes: attributes(axi.bresp as 2, axi.buser as REASON_BITS),
    );
}
