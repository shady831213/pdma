// First executable profile: 64-bit ordinary AXI5 transfers, bounded bursts.
// AXI5 AWATOP is zero; atomic capabilities remain disabled.
// Address USER is {channel, ContextId}; neither field is a platform identity.
pub package CopyMemory {
    const MAX_CHANNELS: u32                 = 8;
    const CHANNEL_BITS: u32                 = $clog2(MAX_CHANNELS);
    const CONTEXT_BITS: u32                 = 32;
    const USER_BITS   : u32                 = CONTEXT_BITS + CHANNEL_BITS;
    type Channel      = logic<CHANNEL_BITS>;
    alias package Bus = $std::axi4_pkg::<64, 8, 1, USER_BITS, 1, 2, USER_BITS, 2>;
    // This fixed transport encoding covers the supported maximum. Eligibility
    // and wrap use the instantiated channel count, not the tag's binary modulus.
    struct Tag {
        channel: Channel   ,
        slot   : logic  <4>,
    }
    struct Request {
        tag     : Tag       ,
        write   : logic     ,
        address : logic<64> ,
        selector: logic<32> ,
        size    : logic<3>  ,
        length  : logic<3>  ,
        data    : logic<512>,
    }
    struct Receipt {
        tag           : Tag       ,
        data          : logic<512>,
        failed        : logic     ,
        page_fault    : logic     ,
        protocol_error: logic     ,
    }
    // Internal receipt identity is independent of the external AXI ID. Requests
    // within each AXI direction use ID zero and responses therefore stay ordered.
    struct Address {
        channel : Channel    ,
        address : logic  <64>,
        selector: logic  <32>,
        size    : logic  <3> ,
        length  : logic  <3> ,
    }
    struct ReadTracker {
        tag   : Tag     ,
        lane  : logic<3>,
        size  : logic<3>,
        length: logic<3>,
    }
    struct WritePayload {
        data  : logic<512>,
        lane  : logic<3>  ,
        size  : logic<3>  ,
        length: logic<3>  ,
    }
}
pub interface CopyMemoryPort {
    var valid   : logic              ;
    var ready   : logic              ;
    var request : CopyMemory::Request;
    var returned: logic              ;
    var accepted: logic              ;
    var receipt : CopyMemory::Receipt;
    modport master {
        valid   : output,
        ready   : input ,
        request : output,
        returned: input ,
        accepted: output,
        receipt : input ,
    }
    modport slave {
        ..converse(master)
    }
}
