// Routes operations to their owners and holds the response; no shadow copy of channel state.
pub module DmaRegisterBank #(
    param CHANNEL_COUNT: u32   = 1    ,
    param BASE_ADDR    : u32   = 0    ,
    param ATOMIC32     : bbool = false,
    param ATOMIC64     : bbool = false,
) (
    clk                  : input   clock                                                       ,
    rst_n                : input   reset_async_low                                             ,
    port                 : modport RegisterPort::slave                                         ,
    global_reset_busy    : input   logic                                                       ,
    global_fatal         : input   logic                                                       ,
    global_clear         : input   logic                                                       ,
    global_reset_request : output  logic                                                       ,
    global_irq_enable    : output  logic                                                       ,
    clear_channels       : input   logic                        <CHANNEL_COUNT>                ,
    maintenance          : input   logic                        <CHANNEL_COUNT>                ,
    command_advance      : input   logic                        <CHANNEL_COUNT>                ,
    event_advance        : input   logic                        <CHANNEL_COUNT>                ,
    command_advance_ready: output  logic                        <CHANNEL_COUNT>                ,
    event_advance_ready  : output  logic                        <CHANNEL_COUNT>                ,
    event_geometry       : output  logic                        <CHANNEL_COUNT>                ,
    statuses             : input   RegisterState::ChannelStatus                 [CHANNEL_COUNT],
    commands             : output  RegisterState::Ring                          [CHANNEL_COUNT],
    events               : output  RegisterState::Ring                          [CHANNEL_COUNT],
    configurations       : output  RegisterState::ChannelConfig                 [CHANNEL_COUNT],
    actions              : output  RegisterState::ChannelActions                [CHANNEL_COUNT],
) {
    const CHANNEL_BASE   : u32                                    = BASE_ADDR
        + DmaRegistersLayout::channels_offset(CHANNEL_COUNT as u64) as u32;
    const ADMIN_BASE     : u32                                    = BASE_ADDR
        + DmaRegistersLayout::admin_offset(CHANNEL_COUNT as u64) as u32;
    const CONTROL_BASE   : u32                                    = ADMIN_BASE
        + DmaAdminLayout::control_offset(CHANNEL_COUNT as u64) as u32;
    const DISCOVERY_BASE : u32                                    = BASE_ADDR
        + DmaRegistersLayout::discovery_offset(CHANNEL_COUNT as u64) as u32;
    const CAPABILITIES   : u64                                    = ((if ATOMIC32 ? 64'd1 : 64'd0)
            << DmaDiscoveryLayout::CAPABILITIES_ATOMIC32_LSB)
        | ((if ATOMIC64 ? 64'd1 : 64'd0) << DmaDiscoveryLayout::CAPABILITIES_ATOMIC64_LSB);
    let   fatal_value    : u64                                    = (if global_fatal ?
            DmaControlLayout::FATAL_CODE_INTERNAL
        :
            DmaControlLayout::FATAL_CODE_NONE
        ) << DmaControlLayout::FATAL_CODE_LSB;
    let   commit         : logic                                  = port.request_valid && port.request_ready;
    var   channel_results: RegisterAccess::Result [CHANNEL_COUNT];
    var   selected       : RegisterAccess::Result                ;
    var   global_result  : RegisterAccess::Result                ;
    var   candidate      : RegisterAccess::Result                ;
    var   response_valid : logic                                 ;
    var   response       : RegisterBus::Response                 ;

    for i in 0..CHANNEL_COUNT :channels {
        inst owner: ChannelRegisters #(
            BASE      : CHANNEL_BASE + i * DmaRegistersLayout::channels_stride(CHANNEL_COUNT as u64) as u32,
            ADMIN_BASE: ADMIN_BASE + DmaAdminLayout::channels_offset(CHANNEL_COUNT as u64) as u32 + i
                * DmaAdminLayout::channels_stride(CHANNEL_COUNT as u64) as u32,
        ) (
            clk                                                     ,
            rst_n                                                   ,
            request              : port.request                     ,
            commit                                                  ,
            clear                : global_clear || clear_channels[i],
            global_blocked       : global_fatal || global_reset_busy,
            maintenance          : maintenance[i]                   ,
            status               : statuses[i]                      ,
            command_advance      : command_advance[i]               ,
            event_advance        : event_advance[i]                 ,
            command_advance_ready: command_advance_ready[i]         ,
            event_advance_ready  : event_advance_ready[i]           ,
            event_geometry       : event_geometry[i]                ,
            command              : commands[i]                      ,
            events               : events[i]                        ,
            configuration        : configurations[i]                ,
            actions              : actions[i]                       ,
            result               : channel_results[i]               ,
        );
    }

    assign port.request_ready  = (!response_valid || port.response_ready) && rst_n;
    assign port.response_valid = response_valid;
    assign port.response       = response;

    always_comb {
        global_result = RegisterAccess::leaf(
            port.request,
            DISCOVERY_BASE + DmaDiscoveryLayout::CHANNEL_NUM_OFFSET,
            DmaDiscoveryLayout::CHANNEL_NUM_BYTES,
            CHANNEL_COUNT as u64,
            DmaDiscoveryLayout::CHANNEL_NUM_READ,
            DmaDiscoveryLayout::CHANNEL_NUM_WRITE,
            DmaDiscoveryLayout::CHANNEL_NUM_WRITABLE,
        );
        candidate     = RegisterAccess::leaf(
            port.request,
            DISCOVERY_BASE + DmaDiscoveryLayout::CAPABILITIES_OFFSET,
            DmaDiscoveryLayout::CAPABILITIES_BYTES,
            CAPABILITIES,
            DmaDiscoveryLayout::CAPABILITIES_READ,
            DmaDiscoveryLayout::CAPABILITIES_WRITE,
            DmaDiscoveryLayout::CAPABILITIES_WRITABLE,
        );
        if candidate.matched {
            global_result = candidate;
        }
        candidate = RegisterAccess::leaf(
            port.request,
            CONTROL_BASE + DmaControlLayout::IRQ_ENABLE_OFFSET,
            DmaControlLayout::IRQ_ENABLE_BYTES,
            global_irq_enable as u64,
            DmaControlLayout::IRQ_ENABLE_READ,
            DmaControlLayout::IRQ_ENABLE_WRITE,
            DmaControlLayout::IRQ_ENABLE_WRITABLE,
        );
        if candidate.write && (global_reset_busy || global_clear) {
            candidate.write  = 0;
            candidate.status = RegisterBus::SLVERR;
        }
        if candidate.matched {
            global_result = candidate;
        }
        candidate = RegisterAccess::leaf(
            port.request,
            CONTROL_BASE + DmaControlLayout::FATAL_OFFSET,
            DmaControlLayout::FATAL_BYTES,
            fatal_value,
            DmaControlLayout::FATAL_READ,
            DmaControlLayout::FATAL_WRITE,
            DmaControlLayout::FATAL_WRITABLE,
        );
        if candidate.matched {
            global_result = candidate;
        }
        candidate = RegisterAccess::leaf(
            port.request,
            CONTROL_BASE + DmaControlLayout::RESET_OFFSET,
            DmaControlLayout::RESET_BYTES,
            global_reset_busy as u64,
            DmaControlLayout::RESET_READ,
            DmaControlLayout::RESET_WRITE,
            DmaControlLayout::RESET_WRITABLE,
        );
        if candidate.matched {
            global_result = candidate;
        }
        global_reset_request = commit && candidate.write && candidate.value[0];
        selected             = global_result;
        for i in 0..CHANNEL_COUNT {
            if channel_results[i].matched {
                selected = channel_results[i];
            }
        }
        if port.request.address[1:0] != 0 {
            selected.status = RegisterBus::SLVERR;
            selected.data   = 0;
        }
    }
    always_ff (clk, rst_n) {
        if_reset {
            response_valid    = 0;
            response          = '0;
            global_irq_enable = 0;
        } else {
            if global_clear {
                global_irq_enable = 0;
            } else if commit && global_result.write && port.request.address == CONTROL_BASE
                + DmaControlLayout::IRQ_ENABLE_OFFSET {
                global_irq_enable = global_result.value[0];
            }
            if commit {
                response_valid  = 1;
                response.data   = selected.data;
                response.status = selected.status;
            } else if port.response_ready {
                response_valid = 0;
            }
        }
    }
}
