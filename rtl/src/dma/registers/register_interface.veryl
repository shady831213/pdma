// Control-plane assembly only. Execution, IRQ and lifecycle owners connect at the core-domain ports.
pub module DmaRegisterInterface::<B: $std::axi4_lite_prototype> #(
    param CHANNEL_COUNT: u32   = 1    ,
    param BASE_ADDR    : u32   = 0    ,
    param ATOMIC32     : bbool = false,
    param ATOMIC64     : bbool = false,
) (
    reg_clk              : input   'cfg  clock                                                        ,
    reg_rst_n            : input   'cfg  reset_async_low                                              ,
    core_clk             : input   'core clock                                                        ,
    core_rst_n           : input   'core reset_async_low                                              ,
    axi                  : modport 'cfg  $std::axi4_lite_if::<B>::slave                               ,
    global_reset_busy    : input   'core logic                                                        ,
    global_fatal         : input   'core logic                                                        ,
    global_clear         : input   'core logic                                                        ,
    global_reset_request : output  'core logic                                                        ,
    global_irq_enable    : output  'core logic                                                        ,
    clear_channels       : input   'core logic                         <CHANNEL_COUNT>                ,
    maintenance          : input   'core logic                         <CHANNEL_COUNT>                ,
    command_advance      : input   'core logic                         <CHANNEL_COUNT>                ,
    event_advance        : input   'core logic                         <CHANNEL_COUNT>                ,
    command_advance_ready: output  'core logic                         <CHANNEL_COUNT>                ,
    event_advance_ready  : output  'core logic                         <CHANNEL_COUNT>                ,
    event_geometry       : output  'core logic                         <CHANNEL_COUNT>                ,
    statuses             : input   'core RegisterState::ChannelStatus                  [CHANNEL_COUNT],
    commands             : output  'core RegisterState::Ring                           [CHANNEL_COUNT],
    events               : output  'core RegisterState::Ring                           [CHANNEL_COUNT],
    configurations       : output  'core RegisterState::ChannelConfig                  [CHANNEL_COUNT],
    actions              : output  'core RegisterState::ChannelActions                 [CHANNEL_COUNT],
) {
    inst source_port: 'cfg  RegisterPort;
    inst target_port: 'core RegisterPort;
    inst frontend: RegisterFrontend::<B> (
        clk  : reg_clk    ,
        rst_n: reg_rst_n  ,
        axi               ,
        core : source_port,
    );
    inst crossing: common_cell::DuplexMailbox #(
        REQUEST_TYPE : RegisterBus::Request ,
        RESPONSE_TYPE: RegisterBus::Response,
    ) (
        s_clk           : reg_clk                   ,
        s_rst_n         : reg_rst_n                 ,
        s_valid         : source_port.request_valid ,
        s_ready         : source_port.request_ready ,
        s_request       : source_port.request       ,
        s_response_valid: source_port.response_valid,
        s_response_ready: source_port.response_ready,
        s_response      : source_port.response      ,
        d_clk           : core_clk                  ,
        d_rst_n         : core_rst_n                ,
        d_valid         : target_port.request_valid ,
        d_ready         : target_port.request_ready ,
        d_request       : target_port.request       ,
        d_response_valid: target_port.response_valid,
        d_response_ready: target_port.response_ready,
        d_response      : target_port.response      ,
    );
    inst owners: DmaRegisterBank #(
        CHANNEL_COUNT  ,
        BASE_ADDR      ,
        ATOMIC32       ,
        ATOMIC64       ,
    ) (
        clk                  : core_clk   ,
        rst_n                : core_rst_n ,
        port                 : target_port,
        global_reset_busy                 ,
        global_fatal                      ,
        global_clear                      ,
        global_reset_request              ,
        global_irq_enable                 ,
        clear_channels                    ,
        maintenance                       ,
        command_advance                   ,
        event_advance                     ,
        command_advance_ready             ,
        event_advance_ready               ,
        event_geometry                    ,
        statuses                          ,
        commands                          ,
        events                            ,
        configurations                    ,
        actions                           ,
    );
}
