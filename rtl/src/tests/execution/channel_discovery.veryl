#[test(multichannel_discovery_uses_instance_configuration)]
module ChannelDiscoveryTest {
    alias package Cfg = $std::axi4_lite_pkg::<32, 4, 1>;
    inst reg_clk :            $tb::clock_gen #( period: 10 );
    inst core_clk:            $tb::clock_gen #( period: 14 );
    inst bus_clk :            $tb::clock_gen #( period: 8 );
    inst reg_rst: $tb::reset_gen (
        clk: reg_clk,
    );
    inst core_rst: $tb::reset_gen (
        clk: core_clk,
    );
    inst bus_rst: $tb::reset_gen (
        clk: bus_clk,
    );
    inst cfg     : 'registers $std::axi4_lite_if::<Cfg>;
    inst memory  : 'bus       $std::axi4_if::<CopyMemory::Bus>;
    var channel_irq     : 'core      logic<2>;
    var device_irq      : 'core      logic   ;
    var device_irq_ready: 'core      logic   ;
    var fatal           : 'core      logic   ;
    inst dut: DmaCopy #(
        CHANNEL_COUNT: 2,
    ) (
        fatal_irq      : device_irq      ,
        fatal_irq_ready: device_irq_ready,
        reg_clk                          ,
        reg_rst_n      : reg_rst         ,
        core_clk                         ,
        core_rst_n     : core_rst        ,
        bus_clk                          ,
        bus_rst_n      : bus_rst         ,
        cfg                              ,
        memory                           ,
        awatop         : _               ,
        irq            : channel_irq     ,
        irq_ready      : 1               ,
        fatal          : fatal           ,
    );
    assign memory.awready = 1;
    assign memory.wready  = 1;
    assign memory.bvalid  = 0;
    assign memory.rid     = 0;
    assign memory.bid     = 0;
    assign memory.rdata   = 0;
    assign memory.bresp   = '0;
    assign memory.buser   = 0;
    initial {
        device_irq_ready = 0;
        memory.arready   = 0;
        memory.rvalid    = 0;
        memory.rresp     = '0;
        memory.ruser     = 0;
        memory.rlast     = 0;
        cfg.awvalid      = 0;
        cfg.wvalid       = 0;
        cfg.bready       = 0;
        cfg.arvalid      = 0;
        cfg.rready       = 0;
        cfg.awaddr       = 0;
        cfg.awprot       = '0;
        cfg.awid         = 0;
        cfg.araddr       = DmaDiscoveryLayout::CHANNEL_NUM_OFFSET as 32;
        cfg.arprot       = '0;
        cfg.arid         = 0;
        cfg.wdata        = 0;
        cfg.wstrb        = '1;
        reg_rst.assert();
        core_rst.assert();
        bus_rst.assert();
        for i in 0..20 {
            reg_clk.next();
            core_clk.next();
            bus_clk.next();
        }
        $assert(cfg.arready, "DISCOVERY_ACCEPT");
        cfg.arvalid = 1;
        reg_clk.next();
        cfg.arvalid = 0;
        for timeout in 0..100 {
            if cfg.rvalid {
                break;
            }
            reg_clk.next();
            core_clk.next();
            bus_clk.next();
        }
        $assert(cfg.rvalid && (cfg.rresp as 2) == 0, "DISCOVERY_RESPONSE");
        $assert(cfg.rdata == 2, "INSTANCE_CHANNEL_COUNT");
        cfg.rready = 1;
        reg_clk.next();
        cfg.rready = 0;
        for setup in 0..4 {
            cfg.awaddr = if setup == 0 ?
                (DmaRegistersLayout::admin_offset(2) + DmaAdminLayout::control_offset(2)
                    + DmaControlLayout::IRQ_ENABLE_OFFSET) as 32
            :
                (DmaRegistersLayout::channels_offset(2) as 32)
                    + case setup {
                        1      : ChannelBlockLayout::COMMAND_CAPACITY_OFFSET as 32,
                        2      : ChannelBlockLayout::COMMAND_PRODUCER_OFFSET as 32,
                        default: ChannelBlockLayout::CONTROL_CONFIG_ENABLE_OFFSET as 32,
                    }
            ;
            cfg.wdata   = if setup == 1 ? 2 : 1;
            cfg.awvalid = 1;
            cfg.wvalid  = 1;
            reg_clk.next();
            cfg.awvalid = 0;
            cfg.wvalid  = 0;
            for timeout in 0..100 {
                if cfg.bvalid {
                    break;
                }
                reg_clk.next();
                core_clk.next();
                bus_clk.next();
            }
            $assert(cfg.bvalid && (cfg.bresp as 2) == 0, "FATAL_TEST_CONFIGURATION");
            cfg.bready = 1;
            reg_clk.next();
            cfg.bready = 0;
        }
        for timeout in 0..100 {
            if memory.arvalid {
                break;
            }
            reg_clk.next();
            core_clk.next();
            bus_clk.next();
        }
        $assert(memory.arvalid && memory.arlen == 7, "DESCRIPTOR_FETCH_FOR_FATAL");
        memory.arready = 1;
        bus_clk.next();
        memory.arready = 0;
        // Reserved response reason is a protocol failure, distinct from a
        // channel memory error. Only the device notification may assert.
        memory.rresp  = 2 as CopyMemory::Bus::resp_t;
        memory.ruser  = 2;
        memory.rvalid = 1;
        for beat in 0..8 {
            memory.rlast = beat == 7;
            for timeout in 0..20 {
                if memory.rready {
                    break;
                }
                bus_clk.next();
            }
            $assert(memory.rready, "MALFORMED_REASON_RECEIPT_ACCEPTED");
            bus_clk.next();
        }
        memory.rvalid = 0;
        for timeout in 0..100 {
            if device_irq {
                break;
            }
            reg_clk.next();
            core_clk.next();
            bus_clk.next();
        }
        $assert(fatal && device_irq && channel_irq == 0, "DEVICE_NOTIFICATION_IS_NOT_CHANNEL_ZERO");
        core_clk.next(5);
        $assert(device_irq, "DEVICE_NOTIFICATION_RETAINED");
        device_irq_ready = 1;
        core_clk.next();
        device_irq_ready = 0;
        core_clk.next(5);
        $assert(fatal && !device_irq && channel_irq == 0, "DEVICE_NOTIFICATION_ACCEPTED_ONCE");

    }
}
