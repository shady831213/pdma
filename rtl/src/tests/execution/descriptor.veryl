#[test(malformed_copy_is_not_accepted)]
module DescriptorTest {
    inst clk   : $tb::clock_gen #( period: 10 );
    inst rst   : $tb::reset_gen ( clk );
    inst memory: CopyMemoryPort;
    var configuration: RegisterState::ChannelConfig    ;
    var status       : RegisterState::ChannelStatus [1];
    var advance      : logic                           ;
    var event_advance: logic                           ;
    inst channels: DmaChannels #( CHANNEL_COUNT: 1 );
    assign channels.command        = '{RegisterState::Ring'{base: 0, capacity: 2, producer: 1, consumer: 0}};
    assign channels.events         = '{RegisterState::Ring'{base: 64'h800, capacity: 2, producer: 0, consumer: 0}};
    assign channels.configuration  = '{configuration};
    assign channels.actions        = '{'0};
    assign channels.reset_all      = 0;
    assign channels.global_blocked = 0;
    assign channels.global_clear   = 0;
    assign channels.fatal_in       = 0;
    assign channels.event_geometry = 1;
    assign channels.event_ready    = 1;
    assign status                  = channels.status;
    assign advance                 = channels.command_advance;
    assign event_advance           = channels.event_advance;
    inst dut: DmaCommandPath (
        clk          ,
        rst_n   : rst,
        memory       ,
        channels     ,
    );
    initial {
        // Reserved option, direct gap, source inactive tail, destination inactive tail.
        for corruption in 0..4 {
            configuration   = '0;
            memory.ready    = 1;
            memory.returned = 0;
            memory.receipt  = '0;
            rst.assert();
            clk.next(3);
            configuration.enable = 1;
            for part in 0..2 {
                for timeout in 0..10 {
                    if memory.valid {
                        break;
                    }
                    clk.next();
                }
                $assert(memory.valid && !memory.request.write, "MALFORMED_COPY_FETCH");
                clk.next();
                memory.ready   = 0;
                memory.receipt = '0;
                if part == 0 {
                    memory.receipt.data[127:64]  = 9;
                    memory.receipt.data[191:128] = 8;
                    memory.receipt.data[319:256] = 64'h200;
                    if corruption == 0 {
                        memory.receipt.data[10] = 1;
                    }
                    if corruption == 1 {
                        memory.receipt.data[16] = 1;
                    }
                    if corruption == 2 {
                        memory.receipt.data[384] = 1;
                    }
                } else {
                    memory.receipt.data[63:0] = 64'h300;
                    if corruption == 3 {
                        memory.receipt.data[128] = 1;
                    }
                }
                memory.returned = 1;
                clk.next();
                memory.returned = 0;
                memory.ready    = 1;
            }
            $assert(!advance, "MALFORMED_COPY_NOT_CONSUMED");
            for timeout in 0..12 {
                if status[0].fatal != 0 {
                    break;
                }
                $assert(!advance, "NO_BAD_ACCEPT");
                clk.next();
            }
            for quiet in 0..5 {
                $assert(
                    status[0].fatal == ChannelRecoveryLayout::FATAL_CODE_COMMANDREAD && !advance && !memory.valid && !event_advance,
                    "MALFORMED_COPY_HAS_NO_EXECUTION_OR_EVENT",
                );
                clk.next();
            }
        }
        $finish();
    }
}
