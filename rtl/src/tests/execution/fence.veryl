#[test(fence_scalar_completion_fault_and_reset)]
module FenceTest {
    inst clk   : $tb::clock_gen #( period: 10 );
    inst rst   : $tb::reset_gen ( clk );
    inst memory: CopyMemoryPort;
    var command        : RegisterState::Ring              ;
    var configuration  : RegisterState::ChannelConfig     ;
    var actions        : RegisterState::ChannelActions    ;
    var status         : RegisterState::ChannelStatus  [1];
    var command_advance: logic                            ;
    var event_advance  : logic                            ;
    var clear          : logic                            ;
    var internal_fatal : logic                            ;
    inst channels: DmaChannels #( CHANNEL_COUNT: 1 );
    assign channels.global_blocked = 0;
    assign channels.global_clear   = 0;
    assign channels.command        = '{command};
    assign channels.events         = '{RegisterState::Ring'{base: 64'h800, capacity: 2, producer: 0, consumer: 0}};
    assign channels.configuration  = '{configuration};
    assign channels.actions        = '{actions};
    assign channels.reset_all      = 0;
    assign channels.fatal_in       = 0;
    assign channels.event_geometry = 1;
    assign channels.event_ready    = 1;
    assign status                  = channels.status;
    assign clear                   = channels.clear;
    assign command_advance         = channels.command_advance;
    assign event_advance           = channels.event_advance;
    assign internal_fatal          = channels.internal_fatal;
    inst dut: CopyEngine (
        clk          ,
        rst_n   : rst,
        memory       ,
        channels     ,
    );
    initial {
        // Widths, faults, reset drain, bad geometry and malformed width encoding.
        for scenario in 0..10 {
            let wide   : logic     = scenario != 0;
            let address: logic<64> = case scenario {
                0      : 64'h304,
                5      : 64'h304,
                6      : 64'hfffffffffffffff8,
                default: 64'h300,
            };
            command         = RegisterState::Ring'{base: 0, capacity: 2, producer: 1, consumer: 0};
            configuration   = '0;
            actions         = '0;
            memory.ready    = 1;
            memory.returned = 0;
            memory.receipt  = '0;
            rst.assert();
            clk.next(3);
            configuration.enable = 1;
            for part in 0..2 {
                for timeout in 0..10 {
                    if memory.valid {
                        break;
                    }
                    clk.next();
                }
                $assert(memory.valid && !memory.request.write, "FENCE_FETCH");
                clk.next();
                memory.receipt = '0;
                if part == 0 {
                    memory.receipt.data[7:0]     = 6;
                    memory.receipt.data[127:64]  = 9;
                    memory.receipt.data[191:128] = address;
                    memory.receipt.data[223:192] = 11;
                    memory.receipt.data[255:224] = if scenario == 7 ? 2 : wide as 32;
                    memory.receipt.data[319:256] = 64'h123456789abcdef0;
                    if scenario == 8 {
                        memory.receipt.data[CommandHeaderLayout::EXTENT * 8] = 1;
                    }
                    if scenario == 9 {
                        memory.receipt.data[FenceCommandLayout::EXTENT * 8] = 1;
                    }
                }
                memory.returned = 1;
                clk.next();
                memory.returned = 0;
            }
            if scenario >= 7 {
                $assert(!command_advance, "MALFORMED_FENCE_NOT_CONSUMED");
            } else {
                $assert(command_advance, "FENCE_ACCEPTED");
                command.consumer = 1;
            }
            for timeout in 0..10 {
                if memory.valid {
                    break;
                }
                clk.next();
            }
            if scenario <: 5 {
                $assert(memory.valid && memory.request.write && memory.request.address == address, "FENCE_TARGET");
                $assert(
                    memory.request.selector == 11 && memory.request.size == (if wide ? 3 : 2) && memory.request.length == 0,
                    "FENCE_SCALAR_WIDTH_CONTEXT",
                );
                $assert(memory.request.data[63:0] == 64'h123456789abcdef0, "FENCE_VALUE");
                clk.next();
                if scenario == 4 {
                    actions.reset_request = 1;
                    clk.next();
                    actions.reset_request = 0;
                    clk.next(5);
                    $assert(status[0].resetting && !clear && !memory.valid, "RESET_DRAINS_FENCE");
                }
                memory.receipt            = '0;
                memory.receipt.failed     = scenario == 2 || scenario == 3;
                memory.receipt.page_fault = scenario == 2;
                memory.returned           = 1;
                clk.next();
                memory.returned = 0;
                if scenario == 2 {
                    clk.next(3);
                    $assert(status[0].faulted && !status[0].error && !memory.valid && !event_advance, "FENCE_PARKS");
                    actions.resume_request = 1;
                    clk.next();
                    actions.resume_request = 0;
                    // Resume makes the owner eligible; arbitration may take a
                    // cycle before the retained request reaches this interface.
                    for timeout in 0..10 {
                        if memory.valid {
                            break;
                        }
                        clk.next();
                    }
                    $assert(
                        memory.valid && memory.request.write && memory.request.address == address
                            && memory.request.selector == 11 && memory.request.size == 3 && memory.request.data[63:0]
                            == 64'h123456789abcdef0,
                        "FENCE_RETRY_RETAINS_TARGET_VALUE",
                    );
                    clk.next();
                    memory.receipt  = '0;
                    memory.returned = 1;
                    clk.next();
                    memory.returned = 0;
                }
            }
            if scenario == 3 || (scenario >= 5 && scenario <: 7) {
                for timeout in 0..10 {
                    if memory.valid {
                        break;
                    }
                    clk.next();
                }
                $assert(
                    status[0].error && memory.valid && memory.request.write && memory.request.address == 64'h800,
                    "FENCE_ERROR_EVENT",
                );
                $assert(
                    memory.request.data[63:0] == 9 && memory.request.data[95:64] == (if scenario == 3 ? 3 : 7)
                        && memory.request.data[191:128] == 0,
                    "FENCE_ERROR_CODE_ZERO_PROGRESS",
                );
                clk.next();
                memory.receipt  = '0;
                memory.returned = 1;
                $assert(event_advance, "FENCE_ERROR_PUBLICATION");
                clk.next();
                memory.returned = 0;
            }
            clk.next(5);
            $assert(!memory.valid && !status[0].faulted && !event_advance && !internal_fatal, "FENCE_TERMINAL");
            if scenario <: 3 {
                $assert(!status[0].error && status[0].fatal == 0, "FENCE_SUCCESS_WITHOUT_ERROR");
            }
            if scenario == 4 {
                $assert(!status[0].resetting, "FENCE_RESET_FINISHES_AFTER_RECEIPT");
            }
            if scenario >= 7 {
                $assert(
                    status[0].fatal == ChannelRecoveryLayout::FATAL_CODE_COMMANDREAD && command.consumer == 0,
                    "MALFORMED_FENCE_COMMAND_READ_FATAL",
                );
            }
        }
        $finish();
    }
}
