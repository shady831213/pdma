#[test(fence_waits_for_prior_copy_write_receipt)]
module FenceOrderTest {
    inst clk: $tb::clock_gen #( period: 10 );
    inst rst: $tb::reset_gen ( clk );
    var finished: logic;
    inst scenario: FenceOrderScenario (
        clk          ,
        rst_n   : rst,
        finished     ,
    );
    initial {
        rst.assert();
        for cycle in 0..200 {
            clk.next();
            if finished {
                break;
            }
        }
        $assert(finished, "COPY_PREFETCH_FENCE_COMPLETED");
    }
}
module FenceOrderScenario::<DATA_BYTES: u32 = 8, BEATS: u32 = 8, SLOTS: u32 = 8> (
    clk     : input  clock          ,
    rst_n   : input  reset_async_low,
    finished: output logic          ,
) {
    alias package M = CopyMemory::<DATA_BYTES, BEATS, SLOTS>;
    const FENCE64: u32 = if DATA_BYTES == 4 ? 1 : 0;
    inst memory: CopyMemoryPort::<DATA_BYTES, BEATS, SLOTS>;
    var command        : RegisterState::Ring             ;
    var configuration  : RegisterState::ChannelConfig    ;
    var status         : RegisterState::ChannelStatus [1];
    var command_advance: logic                           ;
    var event_advance  : logic                           ;
    var clear          : logic                           ;
    var internal_fatal : logic                           ;

    inst channels: DmaChannels #( CHANNEL_COUNT: 1 );
    assign channels.global_blocked = 0;
    assign channels.global_clear   = 0;
    assign channels.command        = '{command};
    assign channels.events         = '{'0};
    assign channels.configuration  = '{configuration};
    assign channels.actions        = '{'0};
    assign channels.reset_all      = 0;
    assign channels.fatal_in       = 0;
    assign channels.event_geometry = 0;
    assign channels.event_ready    = 0;
    assign status                  = channels.status;
    assign clear                   = channels.clear;
    assign command_advance         = channels.command_advance;
    assign event_advance           = channels.event_advance;
    assign internal_fatal          = channels.internal_fatal;
    inst dut: DmaCommandPath::<DATA_BYTES, BEATS, SLOTS> ( clk, rst_n, memory, channels );

    function descriptor (
        index: input u32,
    ) -> logic<768> {
        var value: logic<768>;
        value = 0;
        if index == 0 {
            value[191:128] = 8;
            value[319:256] = 64'h200;
            value[575:512] = 64'h300;
        } else {
            value[7:0]     = 6;
            value[191:128] = if FENCE64 == 1 ? 64'h408 : 64'h404;
            value[255:224] = FENCE64;
            value[319:256] = if FENCE64 == 1 ? 64'habcd987612345678 : 64'h12345678;
        }
        return value;
    }
    var pending_fetch: logic                ;
    var fetch_data   : logic <M::BURST_BITS>;
    var read_pending : logic                ;
    var write_pending: logic                ;
    var tag          : M::Tag               ;
    var fetched      : u32                  ;
    var accepted     : u32                  ;
    var hold_cycles  : u32                  ;
    var copy_complete: logic                ;
    var fence_seen   : logic                ;
    assign configuration = RegisterState::ChannelConfig'{
        enable       : 1       ,
        configured   : 1       ,
        ring_context : 0       ,
        irq_enable   : 0       ,
        irq_mask     : 0
    };
    assign command       = RegisterState::Ring'{base: 0, capacity: 2, producer: 2, consumer: accepted};
    assign memory.ready  = 1;
    let release_write: logic = write_pending && (fence_seen || (fetched == 192 && hold_cycles >= 20));
    assign memory.returned = pending_fetch || read_pending || release_write;
    assign memory.receipt  = M::Receipt'{
        tag           : if pending_fetch ? '0 : tag,
        data          : if pending_fetch ? fetch_data : 64'habcdef as M::BURST_BITS,
        failed        : 0                                                          ,
        page_fault    : 0                                                          ,
        protocol_error: 0                                                          ,
        orphan        : 0                                                          ,
    };
    always_ff (clk, rst_n) {
        if_reset {
            pending_fetch = 0;
            read_pending  = 0;
            write_pending = 0;
            fetched       = 0;
            accepted      = 0;
            hold_cycles   = 0;
            copy_complete = 0;
            fence_seen    = 0;
            finished      = 0;
            fetch_data    = 0;
            tag           = '0;
        } else {
            if command_advance {
                $assert(accepted == 0 || copy_complete, "FENCE_ACCEPTED_AFTER_COPY");
                accepted += 1;
            }
            if memory.returned && memory.accepted {
                if pending_fetch {
                    pending_fetch = 0;
                } else if read_pending {
                    read_pending  = 0;
                } else {
                    write_pending = 0;
                    if fence_seen {
                        finished      = 1;
                    } else {
                        copy_complete = 1;
                    }
                }
            }
            if memory.valid && memory.ready {
                if !memory.request.write && memory.request.tag.slot == 0 {
                    $assert(memory.request.address == fetched && fetched <: 192, "PREFETCH_ORDER");
                    fetch_data    =  (descriptor(fetched / 96) >> ((fetched % 96) * 8)) as M::BURST_BITS;
                    fetched       += ((memory.request.length as u32) + 1) << memory.request.size;
                    pending_fetch =  1;
                } else if !memory.request.write {
                    $assert(accepted == 1 && memory.request.address == 64'h200, "COPY_READ");
                    tag          = memory.request.tag;
                    read_pending = 1;
                } else if memory.request.address == 64'h300 {
                    $assert(accepted == 1 && memory.request.data[63:0] == 64'habcdef, "COPY_WRITE");
                    tag           = memory.request.tag;
                    write_pending = 1;
                } else {
                    $assert(accepted == 2 && copy_complete && !fence_seen, "NO_EARLY_FENCE");
                    $assert(memory.request.address == (if FENCE64 == 1 ? 64'h408 : 64'h404), "FENCE_ADDRESS");
                    $assert(memory.request.size == 2 && memory.request.length == FENCE64, "FENCE_GEOMETRY");
                    $assert(
                        memory.request.data[63:0] == (if FENCE64 == 1 ? 64'habcd987612345678 : 64'h12345678),
                        "FENCE_VALUE",
                    );
                    tag           = memory.request.tag;
                    fence_seen    = 1;
                    write_pending = 1;
                }
            }
            if write_pending {
                hold_cycles += 1;
            }
            $assert(
                !status[0].error && status[0].fatal == 0 && !status[0].faulted && !internal_fatal && !event_advance && !clear,
                "HEALTHY_COPY_FENCE",
            );
        }
    }
}
