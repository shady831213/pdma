#[test(fence_waits_for_prior_copy_write_receipt)]
module FenceOrderTest {
    inst clk   : $tb::clock_gen #( period: 10 );
    inst rst   : $tb::reset_gen ( clk );
    inst memory: CopyMemoryPort;
    var command        : RegisterState::Ring                ;
    var configuration  : RegisterState::ChannelConfig       ;
    var status         : RegisterState::ChannelStatus    [1];
    var command_advance: logic                              ;
    var event_advance  : logic                              ;
    var clear          : logic                              ;
    var internal_fatal : logic                              ;
    var held_slot      : logic                       <4>    ;
    inst dut: CopyEngine (
        global_blocked : 0               ,
        global_clear   : 0               ,
        clk                              ,
        rst_n          : rst             ,
        command        : '{command},
        events         : '{'0},
        configuration  : '{configuration},
        actions        : '{'0},
        reset_all      : 0               ,
        fatal_in       : 0               ,
        event_geometry : 0               ,
        event_ready    : 0               ,
        status                           ,
        clear                            ,
        command_advance                  ,
        event_advance                    ,
        internal_fatal                   ,
        memory                           ,
    );
    initial {
        command         = RegisterState::Ring'{base: 0, capacity: 2, producer: 2, consumer: 0};
        configuration   = '0;
        memory.ready    = 1;
        memory.returned = 0;
        memory.receipt  = '0;
        rst.assert();
        clk.next(3);
        configuration.enable = 1;
        for operation in 0..2 {
            for part in 0..2 {
                for timeout in 0..10 {
                    if memory.valid {
                        break;
                    }
                    clk.next();
                }
                $assert(
                    memory.valid && !memory.request.write && memory.request.address == operation * 96 + part * 64,
                    "ORDERED_FETCH",
                );
                clk.next();
                memory.receipt = '0;
                if operation == 0 {
                    if part == 0 {
                        memory.receipt.data[191:128] = 8;
                        memory.receipt.data[319:256] = 64'h200;
                    } else {
                        memory.receipt.data[63:0] = 64'h300;
                    }
                } else if part == 0 {
                    memory.receipt.data[7:0]     = 6;
                    memory.receipt.data[191:128] = 64'h404;
                    memory.receipt.data[319:256] = 64'h12345678;
                }
                memory.returned = 1;
                clk.next();
                memory.returned = 0;
            }
            $assert(command_advance, "ORDERED_COMMAND_ACCEPTED");
            command.consumer = operation + 1;
            if operation == 0 {
                for timeout in 0..10 {
                    if memory.valid {
                        break;
                    }
                    clk.next();
                }
                $assert(memory.valid && !memory.request.write && memory.request.address == 64'h200, "COPY_READ");
                held_slot = memory.request.tag.slot;
                clk.next();
                memory.receipt          = '0;
                memory.receipt.tag.slot = held_slot;
                memory.receipt.data     = 64'habcdef;
                memory.ready            = 0;
                memory.returned         = 1;
                clk.next();
                memory.returned = 0;
                memory.ready    = 1;
            }
            for timeout in 0..10 {
                if memory.valid {
                    break;
                }
                clk.next();
            }
            $assert(
                memory.valid && memory.request.write && memory.request.address == (if operation == 0 ? 64'h300 : 64'h404),
                "ORDERED_WRITE_TARGET",
            );
            if operation == 1 {
                $assert(
                    memory.request.size == 2 && memory.request.length == 0 && memory.request.data[31:0] == 32'h12345678,
                    "COMPLETION_WORD",
                );
            }
            held_slot = memory.request.tag.slot;
            clk.next();
            for delay in 0..20 {
                $assert(!memory.valid && !command_advance, "NO_SUCCESSOR_BEFORE_WRITE_RECEIPT");
                clk.next();
            }
            memory.receipt          = '0;
            memory.receipt.tag.slot = held_slot;
            memory.returned         = 1;
            clk.next();
            memory.returned = 0;
        }
        clk.next(5);
        $assert(
            !memory.valid && !status[0].error && !status[0].faulted && !internal_fatal && !event_advance,
            "COPY_FENCE_NO_SUCCESS_EVENT",
        );
        $finish();
    }
}
