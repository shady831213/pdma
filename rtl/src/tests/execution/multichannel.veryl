// Architectural ownership oracle. Each channel has a distinct command ring,
// source, destination, context and completion marker. The test memory returns
// receipts using the offered tag; expected data comes from independent addresses.
#[test(multichannel_parked_owners_and_reset)]
module MultiChannelTest {
    const CHANNEL_COUNT: u32 = 8;
    inst clk   : $tb::clock_gen #( period: 10 );
    inst rst   : $tb::reset_gen ( clk );
    inst memory: CopyMemoryPort;
    var commands     : RegisterState::Ring                          [CHANNEL_COUNT];
    var configuration: RegisterState::ChannelConfig                 [CHANNEL_COUNT];
    var actions      : RegisterState::ChannelActions                [CHANNEL_COUNT];
    var statuses     : RegisterState::ChannelStatus                 [CHANNEL_COUNT];
    var clear        : logic                        <CHANNEL_COUNT>                ;
    var advance      : logic                        <CHANNEL_COUNT>                ;
    var event_advance: logic                        <CHANNEL_COUNT>                ;
    var fatal        : logic                                                       ;
    var completed    : logic                        <CHANNEL_COUNT>                ;
    var written      : logic                        <64>            [CHANNEL_COUNT];
    var repair       : logic                                                       ;
    var changed      : logic                                                       ;
    var held         : CopyMemory::Request                                         ;
    var response     : CopyMemory::Receipt                                         ;
    var pending      : logic                                                       ;
    inst dut: CopyEngine #(
        CHANNEL_COUNT  ,
    ) (
        clk                            ,
        rst_n          : rst           ,
        command        : commands      ,
        events         : '{default: '0},
        configuration                  ,
        actions                        ,
        reset_all      : 0             ,
        global_blocked : 0             ,
        global_clear   : 0             ,
        fatal_in       : fatal         ,
        event_geometry : 0             ,
        event_ready    : 0             ,
        status         : statuses      ,
        clear                          ,
        command_advance: advance       ,
        event_advance                  ,
        internal_fatal : fatal         ,
        memory                         ,
    );
    initial {
        commands        = '{default: '0};
        configuration   = '{default: '0};
        actions         = '{default: '0};
        completed       = 0;
        written         = '{default: 0};
        repair          = 0;
        changed         = 0;
        memory.ready    = 0;
        memory.returned = 0;
        memory.receipt  = '0;
        response        = '0;
        pending         = 0;
        rst.assert();
        clk.next(3);
        for channel in 0..CHANNEL_COUNT {
            commands[channel]                   = RegisterState::Ring'{
                base                               : (channel as 64) * 4096,
                capacity                           : 4                     ,
                producer                           : 2                     ,
                consumer                           : 0
            };
            configuration[channel].enable       = 1;
            configuration[channel].ring_context = (channel as 32) + 31;
        }
        for phase in 0..3 {
            if phase == 1 {
                // Reset one parked owner, repair the others, and change all source
                // bytes. Resumed writes must use the bytes already read.
                changed                  = 1;
                repair                   = 1;
                actions[0].reset_request = 1;
                for channel in 1..CHANNEL_COUNT {
                    actions[channel].resume_request = 1;
                }
            }
            if phase == 2 {
                $assert(commands[0].producer == 0, "RESET_CLEARS_ONLY_TARGET");
                configuration[0].enable       = 1;
                configuration[0].ring_context = 31;
                commands[0]                   = RegisterState::Ring'{base: 0, capacity: 4, producer: 2, consumer: 0};
                completed[0]                  = 0;
            }
            for cycle in 0..10000 {
                memory.ready    = !pending;
                memory.returned = pending;
                memory.receipt  = response;
                let consumed       : logic                = pending && memory.accepted;
                let offered        : logic                = memory.valid && memory.ready;
                let old_completed  : logic<CHANNEL_COUNT> = completed;
                if offered {
                    held = memory.request;
                    $assert((held.tag.channel as u32) <: CHANNEL_COUNT, "LEGAL_CHANNEL_ID");
                    let channel     : u32 = held.tag.channel as u32;
                    response     = '0;
                    response.tag = held.tag;
                    if !held.write && held.tag.slot == 0 {
                        $assert(held.selector == channel + 31, "COMMAND_CONTEXT_OWNER");
                        let offset    : u32 = (held.address - (channel as 64) * 4096) as u32;
                        let descriptor: u32 = offset / 96;
                        let part      : u32 = offset % 96;
                        $assert(descriptor <: 2 && (part == 0 || part == 64), "COMMAND_ADDRESS_OWNER");
                        if descriptor == 0 {
                            if part == 0 {
                                response.data[127:64]  = channel as 64;
                                response.data[191:128] = 8;
                                response.data[223:192] = channel + 63;
                                response.data[255:224] = channel + 95;
                                response.data[319:256] = 64'h100000 + (channel as 64) * 4096;
                            } else {
                                response.data[63:0] = 64'h200000 + (channel as 64) * 4096;
                            }
                        } else if part == 0 {
                            response.data[7:0]     = 6;
                            response.data[191:128] = 64'h300000 + (channel as 64) * 4096;
                            response.data[223:192] = channel + 95;
                            response.data[255:224] = 1;
                            response.data[319:256] = channel + 1;
                        }
                    } else if !held.write {
                        $assert(
                            held.address == 64'h100000 + (channel as 64) * 4096 && held.selector == channel + 63,
                            "PAYLOAD_READ_OWNER",
                        );
                        response.data = (64'h12340000 + channel + (if changed ? 256 : 0)) as 512;
                    } else if held.tag.slot != 0 {
                        $assert(
                            held.address == 64'h200000 + (channel as 64) * 4096 && held.selector == channel + 95,
                            "PAYLOAD_WRITE_OWNER",
                        );
                        if !repair && channel + 1 <: CHANNEL_COUNT {
                            response.failed     = 1;
                            response.page_fault = 1;
                        } else {
                            written[channel] = held.data as 64;
                        }
                    } else {
                        $assert(
                            held.address == 64'h300000 + (channel as 64) * 4096 && held.selector == channel + 95,
                            "FENCE_OWNER",
                        );
                        $assert(held.data == channel + 1, "FENCE_DATA_OWNER");
                        $assert(
                            written[channel] == 64'h12340000 + channel + (if phase == 2 && channel == 0 ? 256 : 0),
                            "RETAINED_DATA_AND_FENCE_ORDER",
                        );
                        completed[channel] = 1;
                    }
                }
                for channel in 0..CHANNEL_COUNT {
                    if advance[channel] {
                        commands[channel].consumer += 1;
                    }
                    if clear[channel] {
                        commands[channel]      = '0;
                        configuration[channel] = '0;
                    }
                    $assert(!statuses[channel].error && statuses[channel].fatal == 0, "NO_CHANNEL_ERROR");
                }
                $assert(!fatal && event_advance == 0, "NO_FAULT_EVENT");
                clk.next();
                actions = '{default: '0};
                if consumed {
                    pending = 0;
                }
                if offered {
                    pending = 1;
                }
                if phase == 0 && old_completed[CHANNEL_COUNT - 1] && !pending {
                    for channel in 0..CHANNEL_COUNT - 1 {
                        $assert(statuses[channel].faulted, "ALL_OWNERS_PARKED");
                    }
                    break;
                }
                if phase == 1 && (old_completed | (1 as CHANNEL_COUNT)) == '1 && commands[0].producer == 0 && !pending {
                    break;
                }
                if phase == 2 && (&old_completed) && !pending {
                    break;
                }
                $assert(cycle != 9999, "PEER_PROGRESS_AND_RESET_TIMEOUT");
            }
        }
        $assert(&completed, "EVERY_CHANNEL_COMPLETES_AFTER_RECOVERY");
    }
}
