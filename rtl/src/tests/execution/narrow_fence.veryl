#[test(narrow_copy_fence_preserves_descriptor_and_completion)]
module NarrowFenceOrderTest {
    inst clk: $tb::clock_gen #( period: 10 );
    inst rst: $tb::reset_gen ( clk );
    var finished: logic;
    inst scenario: FenceOrderScenario::<4, 4, 3> (
        clk          ,
        rst_n   : rst,
        finished     ,
    );
    initial {
        rst.assert();
        for cycle in 0..200 {
            clk.next();
            if finished {
                break;
            }
        }
        $assert(finished, "COPY_PREFETCH_FENCE_COMPLETED");
    }
}
