// Hold A's accepted fetch indefinitely. B can fetch and execute its Fence.
// Resetting A keeps precisely that old obligation and rejects the late bytes.
#[test(independent_channel_fetch_and_late_reset_return)]
module IndependentFetchTest {
    const COUNT: u32 = 2;
    inst clk     : $tb::clock_gen #( period: 10 );
    inst rst     : $tb::reset_gen ( clk );
    inst channels: DmaChannels #( CHANNEL_COUNT: COUNT );
    inst memory  : CopyMemoryPort;
    inst dut: DmaCommandPath #(
        CHANNEL_COUNT: COUNT,
    ) (
        clk          ,
        rst_n   : rst,
        channels     ,
        memory       ,
    );
    var rings       : RegisterState::Ring           [COUNT];
    var configs     : RegisterState::ChannelConfig  [COUNT];
    var actions     : RegisterState::ChannelActions [COUNT];
    var pending     : logic                                ;
    var old_tag     : CopyMemory::Tag                      ;
    var reply       : CopyMemory::Receipt                  ;
    var peer_retired: logic                                ;
    var captured    : u32                                  ;
    assign channels.command        = rings;
    assign channels.events         = '{default: '0};
    assign channels.configuration  = configs;
    assign channels.actions        = actions;
    assign channels.reset_all      = 0;
    assign channels.global_blocked = 0;
    assign channels.global_clear   = 0;
    assign channels.fatal_in       = channels.internal_fatal;
    assign channels.event_geometry = 0;
    assign channels.event_ready    = 0;
    initial {
        rings           = '{default: '0};
        configs         = '{default: '0};
        actions         = '{default: '0};
        memory.ready    = 1;
        memory.returned = 0;
        memory.receipt  = '0;
        pending         = 0;
        captured        = 0;
        peer_retired    = 0;
        rst.assert();
        clk.next(3);
        for c in 0..COUNT {
            rings[c]          = RegisterState::Ring'{base: (c as 64) * 4096, capacity: 2, producer: 1, consumer: 0};
            configs[c].enable = 1;
        }
        for cycle in 0..80 {
            memory.returned = pending;
            memory.receipt  = reply;
            let completed      : logic = pending && memory.accepted;
            let peer_advance   : logic = channels.command_advance[1];
            if completed {
                pending         = 0;
            }
            if memory.valid {
                if memory.request.tag.channel == 0 {
                    $assert(captured <: 2 && memory.request.address == captured * 64, "ONLY_ONE_RESERVED_FETCH");
                    captured += 1;
                    old_tag  =  memory.request.tag;
                } else {
                    $assert(captured == 2 || captured == 1, "FIRST_CHANNEL_STILL_OWES_A_RETURN");
                    reply     = '0;
                    reply.tag = memory.request.tag;
                    pending   = 1;
                    if memory.request.write {
                        $assert(memory.request.address == 64'h8000 && memory.request.data == 27, "PEER_FENCE");
                        $assert(rings[1].consumer == 1, "PEER_ACCEPTED_EXACTLY_ONCE");
                        peer_retired = 1;
                    } else if memory.request.address == 4096 {
                        reply.data[7:0]     = 6;
                        reply.data[191:128] = 64'h8000;
                        reply.data[319:256] = 27;
                    } else {
                        $assert(memory.request.address == 4160, "PEER_DESCRIPTOR_TAIL");
                    }
                }
            }
            $assert(!channels.command_advance[0] && !channels.clear[0], "NO_EARLY_ACCEPT_OR_CLEAR");
            clk.next();
            if peer_advance {
                rings[1].consumer += 1;
            }
            if peer_retired && !pending {
                break;
            }
        }
        $assert(peer_retired && captured == 2 && !pending, "HELD_ID_DOES_NOT_BLOCK_PEER");
        actions[0].reset_request = 1;
        clk.next();
        actions[0].reset_request = 0;
        clk.next(3);
        $assert(channels.status[0].resetting && !channels.clear[0], "RESET_WAITS_FOR_FETCH");
        memory.receipt        = '0;
        memory.receipt.tag    = old_tag;
        memory.receipt.data   = '1;
        memory.receipt.failed = 1;
        memory.returned       = 1;
        $assert(memory.accepted, "LATE_RESPONSE_DRAINS");
        clk.next();
        $assert(!channels.clear[0] && channels.status[0].resetting, "FIRST_RLAST_CANNOT_CLEAR_TWO_BURSTS");
        clk.next();
        memory.returned = 0;
        $assert(channels.clear == 1 && channels.command_advance == 0, "ONLY_TARGET_CLEARS");
        configs[0].enable = 0;
        rings[0]          = '0;
        clk.next(4);
        $assert(!memory.valid && !channels.internal_fatal && channels.status[0].fatal == 0, "NO_STALE_DESCRIPTOR");
    }
}
