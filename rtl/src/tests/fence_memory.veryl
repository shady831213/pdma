#[test(fence_word_write_preserves_adjacent_lanes)]
module FenceMemoryTest {
    inst clk : $tb::clock_gen #( period: 10 );
    inst rst : $tb::reset_gen ( clk );
    inst port: CopyMemoryPort;
    inst axi : $std::axi4_if::<CopyMemory::Bus>;
    var observed: logic<64>;
    inst dut: CopyMemoryEndpoint (
        clk       ,
        rst_n: rst,
        port      ,
        axi       ,
    );
    initial {
        port.valid    = 0;
        port.accepted = 0;
        port.request  = '0;
        axi.arready   = 0;
        axi.rvalid    = 0;
        axi.rdata     = 0;
        axi.rresp     = 0 as CopyMemory::Bus::resp_t;
        axi.rlast     = 0;
        axi.rid       = 0;
        axi.ruser     = 0;
        axi.awready   = 0;
        axi.wready    = 0;
        axi.bvalid    = 0;
        axi.bresp     = 0 as CopyMemory::Bus::resp_t;
        axi.bid       = 0;
        axi.buser     = 0;
        rst.assert();
        clk.next(3);
        for scenario in 0..3 {
            observed             = 64'h1122334455667788;
            port.request.write   = 1;
            port.request.address = if scenario == 1 ? 64'h304 : 64'h300;
            port.request.size    = case scenario {
                0      : 0,
                1      : 2,
                default: 3,
            };
            port.request.data = 64'habcdef0198765432;
            port.valid        = 1;
            clk.next();
            port.valid = 0;
            $assert(axi.awvalid && axi.wvalid, "WORD_WRITE_OFFER");
            $assert(
                axi.wstrb
                    == case scenario {
                        0      : 8'h01,
                        1      : 8'hf0,
                        default: 8'hff,
                    },
                "WORD_WRITE_STROBES",
            );
            for lane in 0..8 {
                if axi.wstrb[lane] {
                    observed[lane * 8+:8] = axi.wdata[lane * 8+:8];
                }
            }
            $assert(
                observed
                    == case scenario {
                        0      : 64'h1122334455667732,
                        1      : 64'h9876543255667788,
                        default: 64'habcdef0198765432,
                    },
                "WORD_WRITE_DATA_AND_GUARD_BYTES",
            );
            clk.next(3);
            $assert(axi.awvalid && axi.wvalid, "WORD_STABLE_UNDER_BACKPRESSURE");
            axi.awready = 1;
            axi.wready  = 1;
            clk.next();
            axi.awready = 0;
            axi.wready  = 0;
            axi.bvalid  = 1;
            clk.next();
            axi.bvalid = 0;
            $assert(port.returned && !port.receipt.failed, "WORD_WRITE_RECEIPT");
            port.accepted = 1;
            clk.next();
            port.accepted = 0;
        }
        $finish();
    }
}
