// Admission must retain a credit until that direction's terminal bus response.
#[test(memory_endpoint_configured_credits)]
module MemoryCapacityTest {
    const READ_CAPACITY : u32 = 1;
    const WRITE_CAPACITY: u32 = 3;
    var   capacity      : u32;
    var   requests      : u32;
    inst clk : $tb::clock_gen #( period: 10 );
    inst rst : $tb::reset_gen ( clk );
    inst port: CopyMemoryPort;
    inst axi : $std::axi4_if::<$std::axi4_pkg::<64, 8, 1, 35, 1, 2, 35, 2>>;
    inst dut: CopyMemoryEndpoint #(
        READ_OUTSTANDING : READ_CAPACITY ,
        WRITE_OUTSTANDING: WRITE_CAPACITY,
    ) (
        clk             ,
        fetch_valid: 0  ,
        fetch_ready: _  ,
        fetch      : '0 ,
        rst_n      : rst,
        port            ,
        axi             ,
    );
    var issued   : u32;
    var addresses: u32;
    var data     : u32;
    var responses: u32;
    var receipts : u32;
    initial {
        for direction in 0..2 {
            capacity      = if direction == 0 ? READ_CAPACITY : WRITE_CAPACITY;
            requests      = capacity + 1;
            port.valid    = 0;
            port.accepted = 1;
            port.request  = '0;
            axi.arready   = 1;
            axi.awready   = 1;
            axi.wready    = 1;
            axi.rvalid    = 0;
            axi.rdata     = 0;
            axi.rlast     = 1;
            axi.rid       = 1;
            axi.ruser     = 0;
            axi.rresp     = 0 as $std::axi4_pkg::<64, 8, 1, 35, 1, 2, 35, 2>::resp_t;
            axi.bvalid    = 0;
            axi.bid       = 1;
            axi.buser     = 0;
            axi.bresp     = 0 as $std::axi4_pkg::<64, 8, 1, 35, 1, 2, 35, 2>::resp_t;
            issued        = 0;
            addresses     = 0;
            data          = 0;
            responses     = 0;
            receipts      = 0;
            rst.assert();
            clk.next(3);
            for cycle in 0..60 {
                port.valid            = issued <: requests;
                port.request.write    = direction == 1;
                port.request.address  = 64'h1000 + issued * 8;
                port.request.size     = 3;
                port.request.tag.slot = (issued + 1) as 4;
                // Hold terminal responses after all configured credits fill.
                axi.rvalid = direction == 0 && cycle >= 12 && responses <: addresses;
                axi.bvalid = direction == 1 && cycle >= 12 && responses <: addresses && responses <: data;
                if cycle == 12 {
                    $assert(issued == capacity, "CONFIGURED_ADMISSION_BOUND");
                    $assert(!port.ready, "NO_CREDIT_BEFORE_TERMINAL_RESPONSE");
                }
                if port.valid && port.ready {
                    issued += 1;
                }
                if (axi.arvalid && axi.arready) || (axi.awvalid && axi.awready) {
                    addresses += 1;
                }
                if axi.wvalid && axi.wready {
                    data += 1;
                }
                if (axi.rvalid && axi.rready) || (axi.bvalid && axi.bready) {
                    responses += 1;
                }
                if port.returned && port.accepted {
                    $assert(port.receipt.tag.slot == receipts + 1, "CREDIT_REUSE_PRESERVES_IDENTITY");
                    $assert(!port.receipt.failed && !port.receipt.protocol_error, "CREDIT_REUSE_SUCCESS");
                    receipts += 1;
                }
                clk.next();
            }
            $assert(issued == requests && receipts == requests, "TERMINAL_RESPONSE_RETURNS_CREDIT");
        }
        $finish();
    }
}
