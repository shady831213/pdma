#[test(mixed_errors_and_unowned_responses)]
module MemoryErrorsTest {
    alias package B = $std::axi4_pkg::<64, 8, 2, 35, 1, 2, 35, 2>;
    inst clk : $tb::clock_gen #( period: 10 );
    inst rst : $tb::reset_gen ( clk );
    inst axi : $std::axi4_if::<B>;
    inst port: CopyMemoryPort;
    inst dut: CopyMemoryEndpoint::<B> (
        clk             ,
        rst_n      : rst,
        fetch_valid: 0  ,
        fetch      : '0 ,
        fetch_ready: _  ,
        port            ,
        axi             ,
    );
    initial {
        port.valid    = 0;
        port.accepted = 0;
        port.request  = '0;
        axi.arready   = 1;
        axi.awready   = 1;
        axi.wready    = 1;
        axi.rvalid    = 0;
        axi.bvalid    = 0;
        axi.buser     = 0;
        axi.bresp     = 0 as B::resp_t;
        rst.assert();
        clk.next(3);
        for trial in 0..4 {
            port.request.tag.slot = (1 + trial) as CopyMemory::SLOT_BITS;
            port.request.size     = 3;
            port.request.length   = 1;
            port.valid            = 1;
            clk.next();
            port.valid            = 0;
            if trial == 0 {
                // BID and RID are both unowned. Neither may retire the live ID 1.
                for dir in 0..2 {
                    axi.rvalid = dir == 0;
                    axi.bvalid = dir == 1;
                    axi.bid    = 3;
                    axi.rid    = 3;
                    axi.rlast  = 1;
                    axi.rdata  = '1;
                    axi.rresp  = 0 as B::resp_t;
                    axi.ruser  = 0;
                    $assert((axi.rvalid && axi.rready) || (axi.bvalid && axi.bready), "UNOWNED_ACCEPTED");
                    clk.next();
                    axi.rvalid = 0;
                    axi.bvalid = 0;
                    clk.next(2);
                    $assert(port.returned && port.receipt.orphan && port.receipt.protocol_error, "UNOWNED_FLAGGED");
                    port.accepted = 1;
                    clk.next();
                    port.accepted = 0;
                }
            }
            for beat in 0..2 {
                axi.rid    = 1;
                axi.rlast  = beat == 1;
                axi.rvalid = 1;
                axi.rresp  = (if trial == 3 ? 0 : 2) as B::resp_t;
                axi.ruser  = if trial == 0 || trial == 3 || (trial == 1 && beat == 1) || (trial == 2 && beat == 0) ?
                    1
                :
                    0
                ;
                $assert(axi.rready, "VALID_ID_SURVIVES");
                clk.next();
            }
            axi.rvalid = 0;
            clk.next(2);
            $assert(port.returned && !port.receipt.orphan && port.receipt.tag.slot == trial + 1, "ORIGINAL_OWNER");
            $assert(port.receipt.failed == (trial != 3) && port.receipt.page_fault == (trial == 0), "MIXED_ERRORS");
            $assert(port.receipt.protocol_error == (trial == 3), "RESERVED_REASON");
            port.accepted = 1;
            clk.next();
            port.accepted = 0;
        }
        // An overdue RLAST may cross the finite beat counter's modulus. The
        // original length violation remains visible when that reply finally ends.
        port.request.tag.slot = 1;
        port.request.length   = 0;
        port.valid            = 1;
        clk.next();
        port.valid            = 0;
        axi.rid               = 1;
        axi.rvalid            = 1;
        axi.ruser             = 0;
        axi.rresp             = 0 as B::resp_t;
        for beat in 0..9 {
            axi.rlast = beat == 8;
            $assert(axi.rready, "EXCESS_BEATS_DRAIN");
            clk.next();
        }
        axi.rvalid = 0;
        clk.next(2);
        $assert(port.returned && port.receipt.protocol_error && !port.receipt.orphan, "OVERRUN_STAYS_WITH_OWNER");
    }
}
