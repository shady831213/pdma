#[test(shared_axi_ar_priority_and_stability)]
module FetchArbitrationTest {
    alias package B = $std::axi4_pkg::<64, 8, 2, 35, 1, 2, 35, 2>;
    inst clk : $tb::clock_gen #( period: 10 );
    inst rst : $tb::reset_gen ( clk );
    inst port: CopyMemoryPort;
    inst axi : $std::axi4_if::<B>;
    var fetch_valid: logic                   ;
    var fetch_ready: logic                   ;
    var fetch      : CopyMemory::FetchAddress;
    inst dut: CopyMemoryEndpoint::<B> (
        clk             ,
        rst_n      : rst,
        port            ,
        axi             ,
        fetch_valid     ,
        fetch_ready     ,
        fetch           ,
    );
    initial {
        port.valid    = 0;
        port.accepted = 1;
        port.request  = '0;
        fetch_valid   = 0;
        fetch         = '0;
        axi.arready   = 1;
        axi.awready   = 1;
        axi.wready    = 1;
        axi.rvalid    = 0;
        axi.bvalid    = 0;
        rst.assert();
        clk.next(3);
        port.request.tag.slot = 1;
        port.request.size     = 3;
        port.request.address  = 64'h2000;
        port.valid            = 1;
        fetch.address         = 64'h3000;
        fetch.channel         = 1;
        fetch_valid           = 1;
        $assert(axi.arvalid && axi.arid == 1 && port.ready && !fetch_ready, "ENGINE_WINS_CONTENDED_AR");
        clk.next();
        port.valid  = 0;
        axi.arready = 0;
        $assert(axi.arvalid && axi.arid == 2 && axi.araddr == fetch.address, "FETCH_PRESENTED");
        clk.next();
        port.valid         = 1;
        port.request.write = 1;
        $assert(port.ready && axi.arvalid && axi.arid == 2, "WRITE_INDEPENDENT_OF_STALLED_AR");
        clk.next();
        port.request.write = 0;
        $assert(
            !port.ready && axi.arvalid && axi.arid == 2 && axi.araddr == fetch.address,
            "STALLED_AR_CANNOT_BE_PREEMPTED",
        );
        axi.arready = 1;
        $assert(fetch_ready && !port.ready, "LOCKED_FETCH_GRANT");
        clk.next();
        fetch_valid = 0;
        $assert(port.ready && axi.arvalid && axi.arid == 1 && axi.araddr == port.request.address, "ENGINE_RESUMES");
    }
}
