#[test(memory_endpoint_wide_profile)]
module MemoryWideProfileTest {
    alias package M = CopyMemory::<16, 4, 4>;
    inst clk : $tb::clock_gen #( period: 10 );
    inst rst : $tb::reset_gen ( clk );
    inst port: CopyMemoryPort::<16, 4, 4>;
    inst axi : $std::axi4_if::<$std::axi4_pkg::<64, 16, 1, 35, 1, 2, 35, 2>>;
    inst dut: CopyMemoryEndpoint::<$std::axi4_pkg::<64, 16, 1, 35, 1, 2, 35, 2>, 4, 4> (
        clk       ,
        rst_n: rst,
        port      ,
        axi       ,
    );
    var offered  : u32;
    var addresses: u32;
    var beats    : u32;
    var first    : u32;
    var last     : u32;
    var replies  : u32;
    var returned : u32;
    initial {
        port.valid    = 0;
        port.accepted = 1;
        port.request  = '0;
        axi.arready   = 1;
        axi.rvalid    = 0;
        axi.rdata     = 0;
        axi.rlast     = 0;
        axi.rid       = 0;
        axi.ruser     = 0;
        axi.rresp     = 0 as $std::axi4_config::resp_variants;
        axi.awready   = 1;
        axi.wready    = 1;
        axi.bvalid    = 0;
        axi.bid       = 0;
        axi.buser     = 0;
        axi.bresp     = 0 as $std::axi4_config::resp_variants;
        offered       = 0;
        addresses     = 0;
        beats         = 0;
        first         = 0;
        last          = 0;
        replies       = 0;
        returned      = 0;
        rst.assert();
        clk.next(3);
        for cycle in 0..100 {
            port.valid            = offered <: 4;
            port.request.write    = 1;
            port.request.tag.slot = (offered + 1) as M::SLOT_BITS;
            port.request.address  = 64'h1000 + offered * 64;
            port.request.size     = 4;
            port.request.length   = 3;
            for word in 0..4 {
                port.request.data[word * 128+:128] = 128'h123456789abcdef0fedcba9876540000 + offered * 4 + word;
            }
            if port.valid && port.ready {
                offered += 1;
            }
            if axi.awvalid && axi.awready {
                $assert(axi.awaddr == 64'h1000 + addresses * 64 && axi.awlen == 3, "STREAM_ADDRESS_ORDER");
                addresses += 1;
            }
            if axi.wvalid && axi.wready {
                $assert(
                    axi.wdata == 128'h123456789abcdef0fedcba9876540000 + beats && axi.wstrb == '1,
                    "STREAM_DATA_ORDER",
                );
                $assert(axi.wlast == (beats % 4 == 3), "STREAM_BURST_END");
                if beats == 0 {
                    first = cycle;
                }
                last  =  cycle;
                beats += 1;
            }
            // Delayed B cannot serialize the next command's address/data lanes.
            axi.bvalid = beats == 16 && addresses == 4 && replies <: 4;
            if axi.bvalid && axi.bready {
                replies += 1;
            }
            if port.returned {
                $assert(!port.receipt.failed && !port.receipt.protocol_error, "STREAM_RECEIPT");
                returned += 1;
            }
            clk.next();
        }
        $assert(offered == 4 && addresses == 4 && beats == 16, "MULTIPLE_WRITES_BEFORE_FIRST_B");
        $assert(last - first == 15, "CONTINUOUS_WRITE_BEATS");
        $assert(replies == 4 && returned == 4, "EXACTLY_ONE_RECEIPT_PER_REQUEST");
        $finish();
    }
}
