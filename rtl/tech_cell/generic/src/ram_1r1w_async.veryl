// Behavioral memory; does not guarantee SRAM inference or qualify a physical macro.
pub module Ram1R1WAsync for common_cell::Ram1R1WAsyncContract #(
    param DEPTH     : u32 = 8                                ,
    param WIDTH     : u32 = 32                               ,
    const ADDR_WIDTH: u32 = if DEPTH >: 1 ? $clog2(DEPTH) : 1,
) (
    read_clk  : input   'r clock               ,
    write_clk : input   'w clock               ,
    read_port : modport 'r RamReadPort::memory ,
    write_port: modport 'w RamWritePort::memory,
) {
    var words: 'w logic<WIDTH> [DEPTH];
    always_ff (write_clk) {
        if write_port.enable {
            for lane in 0..WIDTH {
                if write_port.mask[lane] {
                    words[write_port.address][lane] = write_port.data[lane];
                }
            }
        }
    }
    // This is the behavioral dual-clock memory boundary, not a synchronizer or CDC waiver.
    // The caller excludes read/write collisions; actual macro timing must qualify that contract.
    unsafe (cdc) {
        always_ff (read_clk) {
            read_port.data = if read_port.enable ? words[read_port.address] : '0;
        }
    }
}
