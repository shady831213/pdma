 use super::*;
 
+fn cross_project_constant_widths(reverse: bool) {
+    let geometry = r#"
+    package Geometry::<PARKING: u32> {
+        const ELABORATION_PARKING: u32 = if PARKING >: 0 ? PARKING : 1;
+    }
+    "#;
+    let library = r#"
+    pub package Index::<N: u32> {
+        type Mask = logic<N>;
+        function encode(mask: input Mask) -> Mask { return mask; }
+    }
+    "#;
+    let design = r#"
+    module Child::<DEPTH: u32 = 64> (source: input logic<32>, value: output logic<32>) {
+        alias package I = lib::Index::<DEPTH>;
+        let mask: logic<DEPTH> = source as DEPTH;
+        assign value = I::encode(mask);
+    }
+    module Parent::<PARKING: u32 = 64> (source: input logic<32>, value: output logic<32>) {
+        alias package P = Geometry::<PARKING>;
+        inst child: Child::<P::ELABORATION_PARKING> (source, value);
+    }
+    module Optional::<PARKING: u32 = 64> (source: input logic<32>, value: output logic<32>) {
+        alias package P = Geometry::<PARKING>;
+        if PARKING >: 0 :enabled {
+            inst child: Child::<P::ELABORATION_PARKING> (source, value);
+        } else :disabled {
+            assign value = 0;
+        }
+    }
+    "#;
+    let mut instances = vec![
+        "inst literal: Child::<5> (source, value: literal_value);".to_string(),
+        "inst disabled: Optional::<0> (source, value: disabled_value);".to_string(),
+        "inst enabled: Optional::<9> (source, value: enabled_value);".to_string(),
+    ];
+    let widths = [0, 1, 3, 9, 17];
+    for width in widths {
+        instances.push(format!(
+            "inst p{width}: Parent::<{width}> (source, value: v{width});"
+        ));
+    }
+    if reverse {
+        instances.reverse();
+    }
+    let top = format!(
+        r#"module Top (
+        source: input logic<32>,
+        literal_value: output logic<32>, disabled_value: output logic<32>,
+        enabled_value: output logic<32>,
+        v0: output logic<32>, v1: output logic<32>, v3: output logic<32>,
+        v9: output logic<32>, v17: output logic<32>,
+        ) {{ {} }}"#,
+        instances.join("\n")
+    );
+    for config in Config::all() {
+        let ir = analyze_multi_file_prj(
+            &[geometry, library, design, &top],
+            &config,
+            "Top",
+            &["prj", "lib", "prj", "prj"],
+        )
+        .unwrap();
+        let mut sim = Simulator::new(ir, None);
+        for source in [u32::MAX, 0, 0x15555, 0x10000, 0x100, 4, 1] {
+            sim.set("source", Value::new(u64::from(source), 32, false));
+            sim.step(&Event::clock(VarId::SYNTHETIC));
+            for width in widths {
+                let expected = u64::from(source) & ((1 << width.max(1)) - 1);
+                assert_eq!(
+                    sim.get(&format!("v{width}")).unwrap(),
+                    Value::new(expected, 32, false),
+                    "width={width}, source={source}, reverse={reverse}, {config:?}"
+                );
+            }
+            for (port, mask) in [
+                ("literal_value", 31),
+                ("disabled_value", 0),
+                ("enabled_value", 511),
+            ] {
+                assert_eq!(
+                    sim.get(port).unwrap(),
+                    Value::new(u64::from(source) & mask, 32, false),
+                    "{port}, source={source}, reverse={reverse}, {config:?}"
+                );
+            }
+        }
+    }
+}
+
+#[test]
+fn package_constant_generic_widths_cross_project() {
+    cross_project_constant_widths(false);
+}
+
+#[test]
+fn package_constant_generic_widths_cross_project_reverse_order() {
+    cross_project_constant_widths(true);
+}
