+use super::analyze;
+use crate::AnalyzerError;
+
+#[test]
+fn generic_interface_width_uses_the_callers_known_argument() {
+    let code = r#"
+    interface MaskPort::<N: u32 = 4> { var mask: logic<N>; }
+    module WidthParent::<N: u32 = 8> (result: output logic<N>) {
+        inst port: MaskPort::<N>;
+        assign port.mask = '1;
+        for i in 0..N :row { assign result[i] = port.mask[i]; }
+    }
+    module Top (result4: output logic<4>, result16: output logic<16>) {
+        inst small_parent: WidthParent::<4> (result: result4);
+        inst large_parent: WidthParent::<16> (result: result16);
+    }
+    "#;
+    let errors = analyze(code);
+    assert!(errors.is_empty(), "{errors:?}");
+}
+
+#[test]
+fn generic_interface_width_still_rejects_out_of_range_selects() {
+    let code = r#"
+    interface MaskPort::<N: u32 = 4> { var mask: logic<N>; }
+    module WidthParent::<N: u32 = 8> (result: output logic) {
+        inst port: MaskPort::<N>;
+        assign port.mask = '1;
+        assign result = port.mask[N];
+    }
+    module Top (result: output logic) { inst dut: WidthParent::<4> (result); }
+    "#;
+    assert!(
+        analyze(code)
+            .iter()
+            .any(|error| matches!(error, AnalyzerError::InvalidSelect { .. }))
+    );
+}
+
+#[test]
+fn generic_interface_width_literal_does_not_capture_the_callers_name() {
+    let code = r#"
+    interface MaskPort::<N: u32 = 2> { var mask: logic<N>; }
+    module WidthParent::<N: u32 = 8> (result: output logic<12>) {
+        inst port: MaskPort::<12>;
+        assign port.mask = '1;
+        for i in 0..12 :row { assign result[i] = port.mask[i]; }
+    }
+    module Top (result: output logic<12>) { inst dut: WidthParent::<4> (result); }
+    "#;
+    let errors = analyze(code);
+    assert!(errors.is_empty(), "{errors:?}");
+}
