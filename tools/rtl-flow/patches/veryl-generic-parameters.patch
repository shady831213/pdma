+use super::*;
+
+#[test]
+fn module_parameters_forward_through_generic_component() {
+    let code = r#"
+    proto module Contract #(
+        param DEPTH: u32 = 8,
+    ) (depth: output logic<32>);
+
+    module Cell for Contract #(
+        param DEPTH: u32 = 8,
+    ) (depth: output logic<32>) {
+        assign depth = DEPTH;
+    }
+
+    module Parent::<ENTRIES: u32 = 32, CELL: Contract = Cell> (
+        constant_depth: output logic<32>,
+        expression_depth: output logic<32>,
+    ) {
+        const SETS: u32 = ENTRIES / 4;
+        inst constant_child: CELL #(DEPTH: SETS) (depth: constant_depth);
+        inst expression_child: CELL #(DEPTH: ENTRIES / 4) (depth: expression_depth);
+    }
+
+    module Top (
+        c128: output logic<32>, e128: output logic<32>,
+        c256: output logic<32>, e256: output logic<32>,
+    ) {
+        inst p128: Parent::<128> (constant_depth: c128, expression_depth: e128);
+        inst p256: Parent::<256> (constant_depth: c256, expression_depth: e256);
+    }
+    "#;
+
+    for config in Config::all() {
+        let ir = analyze(code, &config);
+        let mut sim = Simulator::new(ir, None);
+        sim.step(&Event::clock(VarId::SYNTHETIC));
+        for (port, expected) in [("c128", 32), ("e128", 32), ("c256", 64), ("e256", 64)] {
+            assert_eq!(
+                sim.get(port).unwrap(),
+                Value::new(expected, 32, false),
+                "{port}, {config:?}"
+            );
+        }
+    }
+}
