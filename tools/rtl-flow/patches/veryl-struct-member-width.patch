 #[test]
+fn struct_constructor_truncates_expression_members() {
+    let code = r#"
+    module Top (
+        select: input logic,
+        narrow: input logic<8>,
+        wide: input logic<32>,
+        out: output logic<32>,
+    ) {
+        struct Packed {
+            prefix: logic<8>,
+            conditional: logic<8>,
+            arithmetic: logic<8>,
+            suffix: logic<8>,
+        }
+        let value: Packed = Packed'{
+            prefix: 8'ha5,
+            conditional: if select ? narrow : 0,
+            arithmetic: wide + 1,
+            suffix: 8'h5a,
+        };
+        assign out = value;
+    }
+    "#;
+    for config in Config::all() {
+        let ir = analyze(code, &config);
+        let mut sim = Simulator::new(ir, None);
+        for (select, narrow, wide, expected) in [
+            (0, 0x81, 0x12ff, 0xa500005a),
+            (1, 0x81, 0x1201, 0xa581025a),
+            (1, 0xff, 0xffff_ffff, 0xa5ff005a),
+        ] {
+            sim.set("select", Value::new(select, 1, false));
+            sim.set("narrow", Value::new(narrow, 8, false));
+            sim.set("wide", Value::new(wide, 32, false));
+            sim.step(&Event::clock(VarId::SYNTHETIC));
+            assert_eq!(
+                sim.get("out").unwrap(),
+                Value::new(expected, 32, false),
+                "{config:?}"
+            );
+        }
+        if config.use_4state {
+            sim.set("select", Value::new(1, 1, false));
+            sim.set("narrow", Value::new_x(8, false));
+            sim.set("wide", Value::new(0, 32, false));
+            sim.step(&Event::clock(VarId::SYNTHETIC));
+            let out = sim.get("out").unwrap();
+            assert_eq!(out.select(23, 16), Value::new_x(8, false), "{config:?}");
+            assert_eq!(out.select(31, 24), Value::new(0xa5, 8, false), "{config:?}");
+            assert_eq!(out.select(7, 0), Value::new(0x5a, 8, false), "{config:?}");
+        }
+    }
+}
